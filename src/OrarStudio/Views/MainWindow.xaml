<Window x:Class="OrarStudio.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:OrarStudio.UI"
        xmlns:vm="clr-namespace:OrarStudio.ViewModels"
        Title="Orar Studio" Width="1480" Height="920" MinWidth="1120" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Window}"
        FontFamily="{StaticResource Font.UI}" FontSize="13"
        Foreground="{DynamicResource Brush.Text}"
        Icon="pack://application:,,,/Assets/app.ico"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="58" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.InputBindings>
        <KeyBinding Key="Z" Modifiers="Ctrl" Command="{Binding UndoCommand}"/>
        <KeyBinding Key="Y" Modifiers="Ctrl" Command="{Binding RedoCommand}"/>
        <KeyBinding Key="Z" Modifiers="Ctrl+Shift" Command="{Binding RedoCommand}"/>
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding SaveCommand}"/>
        <KeyBinding Key="S" Modifiers="Ctrl+Shift" Command="{Binding SaveAsCommand}"/>
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding OpenCommand}"/>
        <KeyBinding Key="I" Modifiers="Ctrl" Command="{Binding ImportCommand}"/>
        <KeyBinding Key="G" Modifiers="Ctrl" Command="{Binding AutoScheduleCommand}"/>
        <KeyBinding Key="F11" Command="{Binding OpenBoardCommand}"/>
        <KeyBinding Key="D1" Modifiers="Ctrl" Command="{Binding GoToCommand}" CommandParameter="dashboard"/>
        <KeyBinding Key="D2" Modifiers="Ctrl" Command="{Binding GoToCommand}" CommandParameter="orar"/>
        <KeyBinding Key="D3" Modifiers="Ctrl" Command="{Binding GoToCommand}" CommandParameter="general"/>
        <KeyBinding Key="D4" Modifiers="Ctrl" Command="{Binding GoToCommand}" CommandParameter="sarcina"/>
        <KeyBinding Key="E" Modifiers="Ctrl" Command="{Binding GoToCommand}" CommandParameter="export"/>
    </Window.InputBindings>

    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="238"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═══════════ Bara laterală ═══════════ -->
        <Border Background="{DynamicResource Brush.Sidebar}" BorderBrush="{DynamicResource Brush.SidebarBorder}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,16,16,10">
                    <Image Source="pack://application:,,,/Assets/logo.png" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Orar Studio" FontSize="16.5" FontWeight="Bold" Foreground="White"/>
                        <TextBlock Text="Planificator de orar universitar" FontSize="11" Foreground="{DynamicResource Brush.SidebarTextMuted}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom" Margin="12,6,12,14">
                    <Border Height="1" Background="{DynamicResource Brush.SidebarBorder}" Margin="4,0,4,10"/>
                    <Button x:Name="BoardButton" Command="{Binding OpenBoardCommand}" Style="{StaticResource SideButton}"
                            ToolTip="Deschide panoul informativ (ecran pe hol / la ușa sălii) · F11">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE7F4;" Style="{StaticResource Icon}" FontSize="15" HorizontalAlignment="Left"/>
                            <TextBlock Grid.Column="1" Text="Panou informativ" VerticalAlignment="Center"/>
                        </Grid>
                    </Button>
                    <Button Command="{Binding ToggleApiCommand}" Style="{StaticResource SideButton}"
                            ToolTip="Pornește / oprește serverul API (site + panou web)">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE774;" Style="{StaticResource Icon}" FontSize="15" HorizontalAlignment="Left"/>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Server API oprit"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Api.IsRunning}" Value="True">
                                                <Setter Property="Text" Value="Server API pornit"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <Ellipse Grid.Column="2" Width="8" Height="8" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#64748B"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Api.IsRunning}" Value="True">
                                                <Setter Property="Fill" Value="#22C55E"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                        </Grid>
                    </Button>
                    <Button Command="{Binding ToggleThemeCommand}" Style="{StaticResource SideButton}" ToolTip="Comută tema luminoasă / întunecată">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="28"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock FontSize="15" HorizontalAlignment="Left">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                        <Setter Property="Text" Value="&#xE708;"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDark}" Value="True">
                                                <Setter Property="Text" Value="&#xE706;"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Temă întunecată"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDark}" Value="True">
                                                <Setter Property="Text" Value="Temă luminoasă"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Button>
                </StackPanel>

                <ListBox ItemsSource="{Binding NavItems}" SelectedItem="{Binding SelectedNav}" ItemContainerStyle="{StaticResource NavItem}"
                         Background="Transparent" BorderThickness="0" Margin="10,0" Focusable="False"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.Template>
                        <ControlTemplate TargetType="ListBox">
                            <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter/>
                            </ScrollViewer>
                        </ControlTemplate>
                    </ListBox.Template>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:NavItem}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="15" HorizontalAlignment="Left"/>
                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="13.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                <Border Grid.Column="2" CornerRadius="9" Padding="7,1" MinWidth="20" VerticalAlignment="Center"
                                        Visibility="{Binding Badge, Converter={StaticResource NullToVis}}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#334155"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding BadgeIsError}" Value="True">
                                                    <Setter Property="Background" Value="#DC2626"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Text="{Binding Badge}" FontSize="11" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- ═══════════ Zona principală ═══════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="58"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

            <!-- Antet (zona de titlu a ferestrei) -->
            <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="26,0,16,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentPage.Title}" FontSize="17" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding CurrentPage.Subtitle}" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource Btn.Icon}" ui:Ui.Icon="&#xE7A7;" Command="{Binding UndoCommand}"
                                ToolTip="{Binding Store.UndoLabel}" ToolTipService.ShowOnDisabled="True"/>
                        <Button Style="{StaticResource Btn.Icon}" ui:Ui.Icon="&#xE7A6;" Command="{Binding RedoCommand}"
                                ToolTip="{Binding Store.RedoLabel}" ToolTipService.ShowOnDisabled="True" Margin="0,0,8,0"/>
                        <Border Width="1" Height="22" Background="{DynamicResource Brush.Border}" Margin="0,0,8,0"/>
                        <Button Style="{StaticResource Btn.Ghost}" ui:Ui.Icon="&#xE8E5;" Content="Importă" Command="{Binding ImportCommand}"
                                ToolTip="Importă sarcina didactică din fișierele departamentelor (.xlsx, .docx, .csv) · Ctrl+I"/>
                        <Button Style="{StaticResource Btn.Ghost}" ui:Ui.Icon="&#xE945;" Content="Generează" Command="{Binding AutoScheduleCommand}"
                                ToolTip="Plasează automat activitățile nealocate · Ctrl+G" Margin="2,0,8,0"/>
                        <Button Style="{StaticResource Btn.Primary}" ui:Ui.Icon="&#xE74E;" Content="Salvează" Command="{Binding SaveCommand}"
                                ToolTip="{Binding FileTooltip}"/>
                        <Button x:Name="MoreButton" Style="{StaticResource Btn.Icon}" ui:Ui.Icon="&#xE712;" Margin="6,0,0,0" Click="MoreButton_Click" ToolTip="Mai multe">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Proiect nou…" Command="{Binding NewProjectCommand}">
                                        <MenuItem.Icon><TextBlock Text="&#xE8F4;" Style="{StaticResource Icon}" FontSize="13"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Deschide…" InputGestureText="Ctrl+O" Command="{Binding OpenCommand}">
                                        <MenuItem.Icon><TextBlock Text="&#xE838;" Style="{StaticResource Icon}" FontSize="13"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Salvează ca…" InputGestureText="Ctrl+Shift+S" Command="{Binding SaveAsCommand}">
                                        <MenuItem.Icon><TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" FontSize="13"/></MenuItem.Icon>
                                    </MenuItem>
                                    <Separator/>
                                    <MenuItem Header="Importă sarcina didactică…" InputGestureText="Ctrl+I" Command="{Binding ImportCommand}">
                                        <MenuItem.Icon><TextBlock Text="&#xE8E5;" Style="{StaticResource Icon}" FontSize="13"/></MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Header="Încarcă datele demonstrative" Command="{Binding LoadDemoCommand}">
                                        <MenuItem.Icon><TextBlock Text="&#xE7BE;" Style="{StaticResource Icon}" FontSize="13"/></MenuItem.Icon>
                                    </MenuItem>
                                    <Separator/>
                                    <MenuItem Header="Despre Orar Studio" Command="{Binding AboutCommand}">
                                        <MenuItem.Icon><TextBlock Text="&#xE946;" Style="{StaticResource Icon}" FontSize="13"/></MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top" WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button Style="{StaticResource Btn.Chrome}" Content="&#xE921;" Click="Minimize_Click" ToolTip="Minimizează"/>
                        <Button x:Name="MaxButton" Style="{StaticResource Btn.Chrome}" Content="&#xE922;" Click="Maximize_Click" ToolTip="Maximizează"/>
                        <Button Style="{StaticResource Btn.ChromeClose}" Content="&#xE8BB;" Click="Close_Click" ToolTip="Închide"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Pagina curentă -->
            <ContentControl x:Name="PageHost" Grid.Row="1" Content="{Binding CurrentPage}" Focusable="False">
                <ContentControl.RenderTransform>
                    <TranslateTransform x:Name="PageShift"/>
                </ContentControl.RenderTransform>
            </ContentControl>

            <!-- Bara de stare -->
            <Border Grid.Row="2" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0">
                <DockPanel Margin="18,0" TextElement.FontSize="12" TextElement.Foreground="{DynamicResource Brush.TextSecondary}">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{Binding WeekText}" Margin="0,0,18,0"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                            <TextBlock Text="&#xE774;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding Api.Status}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding StatsText}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="&#xE74E;" Style="{StaticResource Icon}" FontSize="11" Margin="0,0,6,0"/>
                        <TextBlock Text="{Binding SaveStatus}" ToolTip="{Binding FileTooltip}"/>
                        <TextBlock Text="·" Margin="8,0"/>
                        <TextBlock Text="{Binding FileLabel}" ToolTip="{Binding FileTooltip}" MaxWidth="260" TextTrimming="CharacterEllipsis"/>
                        <Border Width="1" Height="14" Background="{DynamicResource Brush.Border}" Margin="14,0"/>
                        <Button Style="{StaticResource Btn.Link}" Command="{Binding ShowConflictsCommand}" ToolTip="Mergi la primul conflict din orar">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="{StaticResource Font.Icons}" FontSize="11" Margin="0,1,6,0" VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="&#xE73E;"/>
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Success}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ErrorCount, Converter={StaticResource CountToVis}}" Value="Visible">
                                                    <Setter Property="Text" Value="&#xE783;"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Fără conflicte"/>
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ErrorCount, Converter={StaticResource CountToVis}}" Value="Visible">
                                                    <Setter Property="Text" Value="{Binding ErrorCount, StringFormat='{}{0} lecții în conflict'}"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Button>
                        <Border Width="1" Height="14" Background="{DynamicResource Brush.Border}" Margin="14,0"/>
                        <ProgressBar Width="70" Height="5" Maximum="1" Value="{Binding Coverage, Mode=OneWay}" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding CoverageText}"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ═══════════ Notificări ═══════════ -->
        <ItemsControl Grid.ColumnSpan="2" ItemsSource="{Binding Toasts.Items}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                      Margin="0,0,22,44" Width="400" Focusable="False">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="{x:Type ui:ToastItem}">
                    <Border Margin="0,8,0,0" Padding="14,11" CornerRadius="12" Background="{DynamicResource Brush.Surface}"
                            BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Effect="{StaticResource Shadow.Popup}">
                        <Border.RenderTransform>
                            <TranslateTransform X="0"/>
                        </Border.RenderTransform>
                        <Border.Triggers>
                            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.18"/>
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" From="40" To="0" Duration="0:0:0.22">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut"/>
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Border.Triggers>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Border x:Name="IconBg" Width="28" Height="28" CornerRadius="14" Background="{DynamicResource Brush.InfoSoft}" VerticalAlignment="Top">
                                <TextBlock x:Name="Ico" Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource Brush.Info}"/>
                            </Border>
                            <TextBlock Grid.Column="1" Text="{Binding Message}" TextWrapping="Wrap" Margin="12,0,10,0" VerticalAlignment="Center" FontSize="12.5"/>
                            <Button Grid.Column="2" Style="{StaticResource Btn.Soft}" Content="{Binding ActionText}" Padding="10,3" MinHeight="28" FontSize="12"
                                    Visibility="{Binding ActionText, Converter={StaticResource NullToVis}}" VerticalAlignment="Center"
                                    Command="{Binding DataContext.Toasts.RunCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                            <Button Grid.Column="3" Style="{StaticResource Btn.Icon}" Width="26" Height="26" ui:Ui.Icon="&#xE711;" FontSize="10" Margin="4,0,-4,0"
                                    VerticalAlignment="Top"
                                    Command="{Binding DataContext.Toasts.DismissCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                        </Grid>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Kind}" Value="Success">
                            <Setter TargetName="IconBg" Property="Background" Value="{DynamicResource Brush.SuccessSoft}"/>
                            <Setter TargetName="Ico" Property="Foreground" Value="{DynamicResource Brush.Success}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}" Value="Warning">
                            <Setter TargetName="IconBg" Property="Background" Value="{DynamicResource Brush.WarningSoft}"/>
                            <Setter TargetName="Ico" Property="Foreground" Value="{DynamicResource Brush.Warning}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}" Value="Error">
                            <Setter TargetName="IconBg" Property="Background" Value="{DynamicResource Brush.DangerSoft}"/>
                            <Setter TargetName="Ico" Property="Foreground" Value="{DynamicResource Brush.Danger}"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ═══════════ Indicator de încărcare ═══════════ -->
        <Grid Grid.ColumnSpan="2" Background="{DynamicResource Brush.Overlay}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource Card}" Effect="{StaticResource Shadow.Dialog}" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="26,20">
                <StackPanel Orientation="Horizontal">
                    <ContentControl Style="{StaticResource Spinner}"/>
                    <TextBlock Text="{Binding BusyText}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" Margin="16,0,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Estompare când este deschis un dialog -->
        <Border x:Name="Dim" Grid.ColumnSpan="2" Background="{DynamicResource Brush.Overlay}" Visibility="Collapsed"/>
    </Grid>
</Window>
