<UserControl x:Class="OrarStudio.Views.RoomsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:OrarStudio.UI"
             xmlns:m="clr-namespace:OrarStudio.Models">
    <Grid Margin="20,16,20,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Primary}" ui:Ui.Icon="&#xE710;" Content="Auditoriu nou" Command="{Binding AddCommand}"/>
                <TextBox DockPanel.Dock="Right" Width="230" Margin="0,0,10,0" ui:Ui.Icon="&#xE721;" ui:Ui.Placeholder="Caută sală…"
                         Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"/>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ListBox Style="{StaticResource Segmented}" ItemsSource="{Binding Filters}" SelectedItem="{Binding Filter}">
                        <ListBox.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="{Binding CountText}" Style="{StaticResource Text.Muted}" VerticalAlignment="Center" Margin="14,0,0,0"/>
                </StackPanel>
            </DockPanel>

            <ListBox ItemsSource="{Binding ItemsView}" SelectedItem="{Binding Selected}" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="Rooms_MouseDoubleClick" FocusVisualStyle="{x:Null}">
                <ListBox.Template>
                    <ControlTemplate TargetType="ListBox">
                        <ScrollViewer Focusable="False"><ItemsPresenter Margin="0,0,4,0"/></ScrollViewer>
                    </ControlTemplate>
                </ListBox.Template>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bd" Width="234" Margin="0,0,10,10" Padding="16,14" CornerRadius="14"
                                            Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}"/>
                                            <Setter TargetName="Bd" Property="Effect" Value="{StaticResource Shadow.Card}"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                                            <Setter TargetName="Bd" Property="BorderThickness" Value="2"/>
                                            <Setter TargetName="Bd" Property="Padding" Value="15,13"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type m:Room}">
                        <StackPanel>
                            <DockPanel>
                                <Border x:Name="KindIcon" DockPanel.Dock="Left" Width="38" Height="38" CornerRadius="11" Background="{DynamicResource Brush.CursSoft}">
                                    <TextBlock x:Name="KindGlyph" Text="&#xE825;" Style="{StaticResource Icon}" Foreground="{DynamicResource Brush.Curs}"/>
                                </Border>
                                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding KindLabel}" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DockPanel>
                            <WrapPanel Margin="0,12,0,0">
                                <Border Style="{StaticResource Chip}" Margin="0,0,6,6">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE716;" Style="{StaticResource Icon}" FontSize="10" Margin="0,0,5,0" Foreground="{DynamicResource Brush.TextSecondary}"/>
                                        <TextBlock Style="{StaticResource ChipText}"><Run Text="{Binding Capacity, Mode=OneWay}"/><Run Text=" locuri"/></TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Chip}" Margin="0,0,6,6" Visibility="{Binding Computers, Converter={StaticResource CountToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7F8;" Style="{StaticResource Icon}" FontSize="10" Margin="0,0,5,0" Foreground="{DynamicResource Brush.TextSecondary}"/>
                                        <TextBlock Style="{StaticResource ChipText}"><Run Text="{Binding Computers, Mode=OneWay}"/><Run Text=" PC"/></TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Chip}" Margin="0,0,6,6" Visibility="{Binding HasProjector, Converter={StaticResource BoolToVis}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="&#xE7F4;" Style="{StaticResource Icon}" FontSize="10" Margin="0,0,5,0" Foreground="{DynamicResource Brush.TextSecondary}"/>
                                        <TextBlock Text="proiector" Style="{StaticResource ChipText}"/>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Chip}" Margin="0,0,6,6">
                                    <TextBlock Text="{Binding Building}" Style="{StaticResource ChipText}"/>
                                </Border>
                            </WrapPanel>
                            <TextBlock Text="{Binding UsageLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,2,0,8"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ProgressBar Maximum="1" Value="{Binding Occupancy, Mode=OneWay}" VerticalAlignment="Center" ToolTip="Gradul de ocupare săptămânal"/>
                                <TextBlock Grid.Column="1" Text="{Binding Occupancy, StringFormat={}{0:P0}}" FontSize="11.5" Foreground="{DynamicResource Brush.TextMuted}" Margin="8,0,0,0"/>
                            </Grid>
                        </StackPanel>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static m:RoomKind.SalaSeminar}">
                                <Setter TargetName="KindIcon" Property="Background" Value="{DynamicResource Brush.SeminarSoft}"/>
                                <Setter TargetName="KindGlyph" Property="Foreground" Value="{DynamicResource Brush.Seminar}"/>
                                <Setter TargetName="KindGlyph" Property="Text" Value="&#xE716;"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static m:RoomKind.Universala}">
                                <Setter TargetName="KindIcon" Property="Background" Value="{DynamicResource Brush.SeminarSoft}"/>
                                <Setter TargetName="KindGlyph" Property="Foreground" Value="{DynamicResource Brush.Seminar}"/>
                                <Setter TargetName="KindGlyph" Property="Text" Value="&#xE80F;"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static m:RoomKind.LaboratorInformatica}">
                                <Setter TargetName="KindIcon" Property="Background" Value="{DynamicResource Brush.LabSoft}"/>
                                <Setter TargetName="KindGlyph" Property="Foreground" Value="{DynamicResource Brush.Lab}"/>
                                <Setter TargetName="KindGlyph" Property="Text" Value="&#xE7F8;"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="{x:Static m:RoomKind.LaboratorSpecializat}">
                                <Setter TargetName="KindIcon" Property="Background" Value="{DynamicResource Brush.LabSoft}"/>
                                <Setter TargetName="KindGlyph" Property="Foreground" Value="{DynamicResource Brush.Lab}"/>
                                <Setter TargetName="KindGlyph" Property="Text" Value="&#xE7FC;"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0" Width="400" Margin="16,0,0,0" Visibility="{Binding HasDraft, Converter={StaticResource BoolToVis}}">
            <Grid>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="30" Visibility="{Binding HasDraft, Converter={StaticResource BoolToVisInv}}">
                    <Border Width="56" Height="56" CornerRadius="28" Background="{DynamicResource Brush.AccentSoft}">
                        <TextBlock Text="&#xE825;" Style="{StaticResource Icon}" FontSize="22" Foreground="{DynamicResource Brush.Accent}"/>
                    </Border>
                    <TextBlock Text="Selectați un auditoriu" Style="{StaticResource Text.H3}" HorizontalAlignment="Center" Margin="0,14,0,4"/>
                    <TextBlock Text="Indicați unde se țin cursurile, seminarele și laboratoarele." Style="{StaticResource Text.Muted}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center"/>
                </StackPanel>
                <DockPanel Visibility="{Binding HasDraft, Converter={StaticResource BoolToVis}}">
                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="18,12">
                        <DockPanel>
                            <Button DockPanel.Dock="Left" Style="{StaticResource Btn.Danger}" ui:Ui.Icon="&#xE74D;" Content="Șterge" Command="{Binding DeleteCommand}"
                                    Visibility="{Binding IsNew, Converter={StaticResource BoolToVisInv}}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Anulează" Command="{Binding CancelCommand}" Margin="0,0,8,0"/>
                                <Button Style="{StaticResource Btn.Primary}" ui:Ui.Icon="&#xE74E;" Content="Salvează" Command="{Binding SaveCommand}" IsDefault="True"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20,18,20,18">
                            <TextBlock Text="{Binding FormTitle}" Style="{StaticResource Text.H2}"/>
                            <TextBlock Text="{Binding RoomInfo}" Style="{StaticResource Text.Muted}" Margin="0,4,0,0"/>
                            <Button Style="{StaticResource Btn.Link}" Content="Deschide orarul auditoriului →" Command="{Binding OpenScheduleCommand}" Margin="0,4,0,14"
                                    HorizontalAlignment="Left" Visibility="{Binding IsNew, Converter={StaticResource BoolToVisInv}}"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Numărul / denumirea" Style="{StaticResource Text.Label}"/>
                                    <TextBox Text="{Binding Draft.Name, UpdateSourceTrigger=PropertyChanged}" ui:Ui.Placeholder="ex. 404"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Capacitatea (locuri)" Style="{StaticResource Text.Label}"/>
                                    <TextBox Text="{Binding Draft.Capacity, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="100"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Clădirea / blocul" Style="{StaticResource Text.Label}"/>
                                    <TextBox Text="{Binding Draft.Building, UpdateSourceTrigger=PropertyChanged}" ui:Ui.Placeholder="ex. Blocul IV"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Etajul" Style="{StaticResource Text.Label}"/>
                                    <TextBox Text="{Binding Draft.Floor, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Categoria sălii" Style="{StaticResource Text.Label}" Margin="0,14,0,6"/>
                            <ComboBox ItemsSource="{Binding Kinds}" SelectedItem="{Binding Draft.Kind}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumLabel}}"/></DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <TextBlock Text="Destinația — ce lecții se pot ține aici" Style="{StaticResource Text.Label}" Margin="0,16,0,8"/>
                            <WrapPanel>
                                <CheckBox Content="Cursuri (prelegeri)" IsChecked="{Binding Draft.AllowsCurs}" Margin="0,0,18,8"/>
                                <CheckBox Content="Seminare" IsChecked="{Binding Draft.AllowsSeminar}" Margin="0,0,18,8"/>
                                <CheckBox Content="Laboratoare" IsChecked="{Binding Draft.AllowsLaborator}" Margin="0,0,18,8"/>
                            </WrapPanel>
                            <TextBlock Text="Verificarea conflictelor avertizează când o lecție este plasată într-o sală nepotrivită sau prea mică." Style="{StaticResource Text.Muted}" TextWrapping="Wrap"/>

                            <TextBlock Text="Dotări" Style="{StaticResource Text.Label}" Margin="0,16,0,8"/>
                            <ToggleButton Style="{StaticResource Switch}" Content="Proiector" IsChecked="{Binding Draft.HasProjector}" Margin="0,0,0,10"/>
                            <ToggleButton Style="{StaticResource Switch}" Content="Tablă" IsChecked="{Binding Draft.HasWhiteboard}" Margin="0,0,0,10"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="110"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Calculatoare (stații de lucru)" VerticalAlignment="Center"/>
                                <TextBox Grid.Column="1" Text="{Binding Draft.Computers, UpdateSourceTrigger=PropertyChanged}"/>
                            </Grid>

                            <TextBlock Text="Note" Style="{StaticResource Text.Label}" Margin="0,16,0,6"/>
                            <TextBox Style="{StaticResource Input.Multiline}" Text="{Binding Draft.Notes, UpdateSourceTrigger=PropertyChanged}"/>

                            <Border Background="{DynamicResource Brush.DangerSoft}" CornerRadius="8" Padding="12,9" Margin="0,14,0,0"
                                    Visibility="{Binding ValidationError, Converter={StaticResource NullToVis}}">
                                <TextBlock Text="{Binding ValidationError}" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
