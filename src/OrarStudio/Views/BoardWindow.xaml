<Window x:Class="OrarStudio.Views.BoardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:api="clr-namespace:OrarStudio.Api"
        xmlns:ui="clr-namespace:OrarStudio.UI"
        Title="Panou informativ — Orar Studio" Width="1600" Height="920" MinWidth="960" MinHeight="600"
        WindowStartupLocation="CenterScreen" Background="#0A0F1E" Foreground="#F1F5F9"
        FontFamily="{StaticResource Font.UI}" Icon="pack://application:,,,/Assets/app.ico"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Ideal" KeyDown="Window_KeyDown">
    <Window.Resources>
        <SolidColorBrush x:Key="B.Card" Color="#111A2E"/>
        <SolidColorBrush x:Key="B.Card2" Color="#0E1628"/>
        <SolidColorBrush x:Key="B.Line" Color="#1E2A44"/>
        <SolidColorBrush x:Key="B.Muted" Color="#93A3C0"/>
        <SolidColorBrush x:Key="B.Dim" Color="#62728F"/>
        <SolidColorBrush x:Key="B.Free" Color="#34D399"/>

        <DataTemplate x:Key="Entry" DataType="{x:Type api:BoardEntryDto}">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="Strip" CornerRadius="3" Background="#6366F1"/>
                <StackPanel Grid.Column="1" Margin="12,0,0,0">
                    <TextBlock Text="{Binding Subject}" FontSize="19" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock FontSize="14.5" Foreground="{StaticResource B.Muted}" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding TypeLabel, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  ·  "/><Run Text="{Binding Groups, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding Teacher, Mode=OneWay}"/><Run Text="  ·  aud. "/><Run Text="{Binding Room, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Type}" Value="seminar">
                    <Setter TargetName="Strip" Property="Background" Value="#E0701A"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="laborator">
                    <Setter TargetName="Strip" Property="Background" Value="#0E9F87"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate x:Key="NextEntry" DataType="{x:Type api:BoardEntryDto}">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Background="{StaticResource B.Line}" CornerRadius="6" Padding="8,2" VerticalAlignment="Top" Margin="0,2,12,0">
                    <TextBlock Text="{Binding Time}" FontSize="13.5" FontWeight="SemiBold" Foreground="{StaticResource B.Muted}"/>
                </Border>
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{Binding Subject}" FontSize="16.5" FontWeight="SemiBold" Foreground="#CBD5E1" TextTrimming="CharacterEllipsis"/>
                    <TextBlock FontSize="13.5" Foreground="{StaticResource B.Dim}" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding TypeLabel, Mode=OneWay}"/><Run Text="  ·  "/><Run Text="{Binding Groups, Mode=OneWay}"/><Run Text="  ·  aud. "/><Run Text="{Binding Room, Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <Style x:Key="BoardToggle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="#CBD5E1"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" CornerRadius="8" Padding="12,6" Background="{StaticResource B.Card}" BorderBrush="{StaticResource B.Line}" BorderThickness="1">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#4F46E5"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#4F46E5"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#475569"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="44,28,44,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- antet -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding Institution}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource B.Muted}"/>
                <TextBlock Text="{Binding Faculty}" FontSize="30" FontWeight="Bold" Margin="0,2,0,8" TextTrimming="CharacterEllipsis"/>
                <StackPanel Orientation="Horizontal">
                    <Border Background="#1E1B4B" CornerRadius="8" Padding="12,4" Margin="0,0,10,0">
                        <TextBlock Text="{Binding WeekText}" FontSize="15" FontWeight="SemiBold" Foreground="#C7D2FE"/>
                    </Border>
                    <Border Background="{StaticResource B.Card}" CornerRadius="8" Padding="12,4">
                        <TextBlock Text="Orarul lecțiilor · azi" FontSize="15" Foreground="{StaticResource B.Muted}"/>
                    </Border>
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding Time}" FontSize="76" FontWeight="Bold" LineHeight="76" LineStackingStrategy="BlockLineHeight"/>
                    <TextBlock Text="{Binding Seconds}" FontSize="30" FontWeight="SemiBold" Foreground="{StaticResource B.Dim}" VerticalAlignment="Bottom" Margin="4,0,0,10"/>
                </StackPanel>
                <TextBlock Text="{Binding Date}" FontSize="19" Foreground="{StaticResource B.Muted}" HorizontalAlignment="Right"/>
            </StackPanel>
        </Grid>

        <!-- starea curentă -->
        <Border Grid.Row="1" Background="{StaticResource B.Card}" CornerRadius="16" Padding="22,16" Margin="0,22,0,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="46" Height="46" CornerRadius="23" Background="#1E1B4B">
                    <TextBlock Text="&#xE823;" FontFamily="{StaticResource Font.Icons}" FontSize="20" Foreground="#A5B4FC" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentSlot}" FontSize="22" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding Status}" FontSize="16" Foreground="{StaticResource B.Muted}"/>
                </StackPanel>
                <Grid Grid.Column="2" Width="300" Height="10" VerticalAlignment="Center">
                    <Border Background="{StaticResource B.Line}" CornerRadius="5"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding SlotProgress, Converter={StaticResource Star}}"/>
                            <ColumnDefinition Width="{Binding SlotProgress, Converter={StaticResource Star}, ConverterParameter=rest}"/>
                        </Grid.ColumnDefinitions>
                        <Border CornerRadius="5" Background="#6366F1"/>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- tabel -->
        <Grid x:Name="TableHost" Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Margin="22,0,22,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="1.15*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="FirstHeader" Text="AUDITORIUL" FontSize="13" FontWeight="Bold" Foreground="{StaticResource B.Dim}"/>
                <TextBlock Grid.Column="1" Text="ACUM" FontSize="13" FontWeight="Bold" Foreground="{StaticResource B.Dim}"/>
                <TextBlock Grid.Column="2" Text="URMEAZĂ" FontSize="13" FontWeight="Bold" Foreground="{StaticResource B.Dim}"/>
            </Grid>
            <ItemsControl Grid.Row="1" ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type api:BoardRowDto}">
                        <Border x:Name="Row" Background="{StaticResource B.Card2}" CornerRadius="14" Padding="22,12" Margin="0,0,0,8" MinHeight="84">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="280"/>
                                    <ColumnDefinition Width="1.15*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}" FontSize="25" FontWeight="Bold"/>
                                    <TextBlock Text="{Binding Subtitle}" FontSize="13.5" Foreground="{StaticResource B.Dim}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                                <Grid Grid.Column="1" VerticalAlignment="Center" Margin="0,0,24,0">
                                    <StackPanel x:Name="Free" Orientation="Horizontal" Visibility="Collapsed">
                                        <Ellipse Width="11" Height="11" Fill="{StaticResource B.Free}" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="Liber" FontSize="19" FontWeight="SemiBold" Foreground="{StaticResource B.Free}"/>
                                    </StackPanel>
                                    <ItemsControl ItemsSource="{Binding Now}" ItemTemplate="{StaticResource Entry}"/>
                                </Grid>
                                <Grid Grid.Column="2" VerticalAlignment="Center">
                                    <TextBlock x:Name="NoNext" Text="—" FontSize="18" Foreground="{StaticResource B.Dim}" Visibility="Collapsed"/>
                                    <ItemsControl ItemsSource="{Binding Next}" ItemTemplate="{StaticResource NextEntry}"/>
                                </Grid>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Busy}" Value="False">
                                <Setter TargetName="Free" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Busy}" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource B.Card}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Next.Length}" Value="0">
                                <Setter TargetName="NoNext" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="&#xE787;" FontFamily="{StaticResource Font.Icons}" FontSize="46" Foreground="{StaticResource B.Dim}" HorizontalAlignment="Center"/>
                <TextBlock Text="În acest moment nu sunt lecții" FontSize="26" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,16,0,6"/>
                <TextBlock Text="Pentru demonstrație activați „Mod demonstrativ” în bara de jos și alegeți o zi și o oră din semestru."
                           FontSize="15" Foreground="{StaticResource B.Muted}" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- subsol -->
        <Grid Grid.Row="3" Margin="0,14,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding PageText}" FontSize="14" Foreground="{StaticResource B.Muted}" Margin="0,0,16,0"/>
                    <TextBlock Text="{Binding Updated}" FontSize="13" Foreground="{StaticResource B.Dim}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE946;" FontFamily="{StaticResource Font.Icons}" FontSize="15" Foreground="#A5B4FC" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding Message}" FontSize="16" Foreground="#CBD5E1" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </DockPanel>

            <Border x:Name="Controls" Grid.Row="1" Margin="0,14,0,0" Padding="12,8" CornerRadius="12" Background="{StaticResource B.Card2}"
                    BorderBrush="{StaticResource B.Line}" BorderThickness="1">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource Btn.Chrome}" Content="&#xE76B;" Foreground="#CBD5E1" Width="36" Click="Prev_Click" ToolTip="Pagina anterioară"/>
                        <Button Style="{StaticResource Btn.Chrome}" Content="&#xE76C;" Foreground="#CBD5E1" Width="36" Click="Next_Click" ToolTip="Pagina următoare"/>
                        <Button Style="{StaticResource Btn.Chrome}" Content="&#xE740;" Foreground="#CBD5E1" Width="40" Click="Fullscreen_Click" ToolTip="Ecran complet (F11)"/>
                    </StackPanel>
                    <ListBox ItemsSource="{Binding Modes}" SelectedItem="{Binding Mode}" VerticalAlignment="Center" Background="Transparent" BorderThickness="0"
                             FocusVisualStyle="{x:Null}">
                        <ListBox.Template>
                            <ControlTemplate TargetType="ListBox"><ItemsPresenter/></ControlTemplate>
                        </ListBox.Template>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="Foreground" Value="#CBD5E1"/>
                                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" CornerRadius="8" Padding="12,6" Margin="0,0,6,0" Background="{StaticResource B.Card}"
                                                    BorderBrush="{StaticResource B.Line}" BorderThickness="1">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#4F46E5"/>
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#4F46E5"/>
                                                    <Setter Property="Foreground" Value="White"/>
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#475569"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Icon}" FontFamily="{StaticResource Font.Icons}" FontSize="12" Margin="0,1,7,0"/>
                                    <TextBlock Text="{Binding Label}" FontSize="13"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <ToggleButton Style="{StaticResource BoardToggle}" Content="Doar sălile/grupele active" IsChecked="{Binding OnlyActive}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <ToggleButton Style="{StaticResource BoardToggle}" Content="Mod demonstrativ" IsChecked="{Binding Simulate}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="{Binding Simulate, Converter={StaticResource BoolToVis}}">
                        <DatePicker SelectedDate="{Binding SimDate}" Width="140" Background="{StaticResource B.Card}" Foreground="#F1F5F9" BorderBrush="{StaticResource B.Line}"/>
                        <TextBox Text="{Binding SimTime, UpdateSourceTrigger=PropertyChanged}" Width="70" Margin="6,0,0,0" Background="{StaticResource B.Card}"
                                 Foreground="#F1F5F9" BorderBrush="{StaticResource B.Line}" ToolTip="Ora (HH:mm)"/>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
