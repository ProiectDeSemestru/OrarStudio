<UserControl x:Class="OrarStudio.Views.ExportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:OrarStudio.UI"
             xmlns:vm="clr-namespace:OrarStudio.ViewModels">
    <Grid Margin="20,16,20,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="430"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource Card}" Padding="0">
            <DockPanel>
                <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="20,14">
                    <DockPanel>
                        <CheckBox DockPanel.Dock="Left" Content="Deschide după export" IsChecked="{Binding OpenAfter}" VerticalAlignment="Center"/>
                        <Button HorizontalAlignment="Right" Style="{StaticResource Btn.Primary}" ui:Ui.Icon="&#xE896;" Content="Exportă…"
                                Command="{Binding ExportCommand}" IsEnabled="{Binding IsSupported}" Padding="20,9"/>
                    </DockPanel>
                </Border>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,18,20,18">
                        <TextBlock Text="1. Ce exportăm" Style="{StaticResource Text.H3}" Margin="0,0,0,10"/>
                        <ListBox ItemsSource="{Binding Scopes}" SelectedItem="{Binding Scope}" Background="Transparent" BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.Template>
                                <ControlTemplate TargetType="ListBox"><ItemsPresenter/></ControlTemplate>
                            </ListBox.Template>
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd" Margin="0,0,8,8" Padding="12,9" CornerRadius="10" BorderThickness="1.5"
                                                        BorderBrush="{DynamicResource Brush.Border}" Background="{DynamicResource Brush.Surface}">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentSoft}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="14" Margin="0,0,9,0" Foreground="{DynamicResource Brush.Accent}"/>
                                        <TextBlock Text="{Binding Label}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <StackPanel Visibility="{Binding NeedsEntity, Converter={StaticResource BoolToVis}}" Margin="0,6,0,0">
                            <TextBlock Text="Alegeți" Style="{StaticResource Text.Label}"/>
                            <ComboBox ItemsSource="{Binding Entities}" SelectedItem="{Binding Entity}" IsTextSearchEnabled="True" TextSearch.TextPath="Label">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:EntityOption}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Brush.TextMuted}" Margin="8,0,0,0" FontSize="12"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <TextBlock Text="2. Formatul" Style="{StaticResource Text.H3}" Margin="0,22,0,10"/>
                        <ListBox ItemsSource="{Binding Formats}" SelectedItem="{Binding Format}" Background="Transparent" BorderThickness="0">
                            <ListBox.Template>
                                <ControlTemplate TargetType="ListBox"><ItemsPresenter/></ControlTemplate>
                            </ListBox.Template>
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Cursor" Value="Hand"/>
                                    <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="Bd" Margin="0,0,0,8" Padding="12,10" CornerRadius="10" BorderThickness="1.5"
                                                        BorderBrush="{DynamicResource Brush.Border}" Background="{DynamicResource Brush.Surface}">
                                                    <ContentPresenter/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}"/>
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.AccentSoft}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:FormatOption}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="40"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="32" Height="32" CornerRadius="9" Background="{DynamicResource Brush.Sunken}" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource Brush.Accent}"/>
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Description}" FontSize="11.5" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border Background="{DynamicResource Brush.InfoSoft}" CornerRadius="8" Padding="12,9" Margin="0,6,0,0"
                                Visibility="{Binding SupportNote, Converter={StaticResource NullToVis}}">
                            <TextBlock Text="{Binding SupportNote}" Foreground="{DynamicResource Brush.Text}" TextWrapping="Wrap" FontSize="12"/>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Style="{StaticResource Card}" Padding="18">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                        <ContentControl DockPanel.Dock="Right" Style="{StaticResource Spinner}" Width="18" Height="18"
                                        Visibility="{Binding IsPreviewBusy, Converter={StaticResource BoolToVis}}"/>
                        <StackPanel>
                            <TextBlock Text="Previzualizare" Style="{StaticResource Text.H3}"/>
                            <TextBlock Text="{Binding PreviewInfo}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </DockPanel>
                    <Border Background="{DynamicResource Brush.Sunken}" CornerRadius="10" Padding="16">
                        <Grid>
                            <Border Background="White" HorizontalAlignment="Center" VerticalAlignment="Center" Effect="{StaticResource Shadow.Raised}"
                                    Visibility="{Binding Preview, Converter={StaticResource NullToVis}}">
                                <Image Source="{Binding Preview}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding Preview, Converter={StaticResource NullToVisInv}}">
                                <TextBlock Text="{Binding Format.Icon}" Style="{StaticResource Icon}" FontSize="40" Foreground="{DynamicResource Brush.TextMuted}"/>
                                <TextBlock Text="{Binding Format.Label}" Style="{StaticResource Text.H3}" HorizontalAlignment="Center" Margin="0,12,0,4"/>
                                <TextBlock Text="{Binding Format.Description}" Style="{StaticResource Text.Muted}" HorizontalAlignment="Center" TextWrapping="Wrap" MaxWidth="380" TextAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DockPanel>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18,14" Margin="0,16,0,0"
                    Visibility="{Binding Recent.Count, Converter={StaticResource CountToVis}}">
                <StackPanel>
                    <TextBlock Text="Exporturi recente" Style="{StaticResource Text.H3}" Margin="0,0,0,8"/>
                    <ItemsControl ItemsSource="{Binding Recent}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:RecentExport}">
                                <DockPanel Margin="0,3">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Ghost}" Content="Arată în dosar" Padding="8,3" MinHeight="28"
                                            Command="{Binding DataContext.ShowRecentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Soft}" Content="Deschide" Padding="10,3" MinHeight="28" Margin="0,0,6,0"
                                            Command="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                    <TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource Brush.Accent}" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding When}" Foreground="{DynamicResource Brush.TextMuted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}"/>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
