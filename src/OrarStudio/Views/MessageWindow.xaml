<Window x:Class="OrarStudio.Views.MessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:OrarStudio.UI"
        Style="{StaticResource DialogWindow}" Title="Orar Studio">
    <Border Style="{StaticResource DialogShell}" Width="500">
        <StackPanel>
            <Grid x:Name="Header" Margin="26,24,26,6" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="IconBg" Width="44" Height="44" CornerRadius="22" VerticalAlignment="Top" Background="{DynamicResource Brush.AccentSoft}">
                    <TextBlock x:Name="IconText" Style="{StaticResource Icon}" FontSize="18" Foreground="{DynamicResource Brush.Accent}" Text="&#xE946;"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="16,2,0,0">
                    <TextBlock x:Name="TitleText" Style="{StaticResource Text.H2}" TextWrapping="Wrap"/>
                    <ScrollViewer MaxHeight="380" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                        <TextBlock x:Name="MessageText" Style="{StaticResource Text.Body}" Foreground="{DynamicResource Brush.TextSecondary}" LineHeight="19"/>
                    </ScrollViewer>
                </StackPanel>
            </Grid>
            <Border Style="{StaticResource DialogFooter}" Margin="0,18,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" Content="Anulează" IsCancel="True" Margin="0,0,8,0" Click="Cancel_Click" MinWidth="96"/>
                    <Button x:Name="OkButton" Style="{StaticResource Btn.Primary}" IsDefault="True" Click="Ok_Click" MinWidth="96"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
