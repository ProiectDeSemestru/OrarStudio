<UserControl x:Class="OrarStudio.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:OrarStudio.UI">
    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                <ToggleButton Style="{StaticResource Switch}" Content="Compact" IsChecked="{Binding Compact}" Margin="0,0,18,0"/>
                <ToggleButton Style="{StaticResource Switch}" Content="Ascunde perechile serale goale" IsChecked="{Binding HideEmptySlots}" Margin="0,0,18,0"/>
                <Button ui:Ui.Icon="&#xE8A5;" Content="PDF (A3)" Command="{Binding ExportPdfCommand}" Margin="0,0,8,0"/>
                <Button ui:Ui.Icon="&#xE9F9;" Content="Excel" Command="{Binding ExportExcelCommand}"/>
            </StackPanel>
            <ListBox Style="{StaticResource Segmented}" ItemsSource="{Binding YearFilters}" SelectedItem="{Binding YearFilter}" VerticalAlignment="Center">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Label}"/>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border x:Name="Corner" Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,1">
                    <TextBlock Text="Zi / pereche" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}"
                               VerticalAlignment="Center" HorizontalAlignment="Center"/>
                </Border>
                <ScrollViewer x:Name="HeaderScroll" Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Focusable="False">
                    <Grid x:Name="HeaderGrid" Margin="0,0,16,0"/>
                </ScrollViewer>
                <ScrollViewer x:Name="LeftScroll" Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <Grid x:Name="LeftGrid" Margin="0,0,0,16"/>
                </ScrollViewer>
                <ScrollViewer x:Name="BodyScroll" Grid.Row="1" Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              ScrollChanged="Body_ScrollChanged" Focusable="False">
                    <Grid x:Name="BodyGrid"/>
                </ScrollViewer>
                <StackPanel x:Name="Empty" Grid.RowSpan="2" Grid.ColumnSpan="2" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="&#xE71D;" Style="{StaticResource Icon}" FontSize="32" Foreground="{DynamicResource Brush.TextMuted}"/>
                    <TextBlock Text="Nu există grupe de afișat" Style="{StaticResource Text.H3}" Margin="0,12,0,4" HorizontalAlignment="Center"/>
                    <TextBlock Text="Importați sarcina didactică sau adăugați grupe." Style="{StaticResource Text.Muted}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
