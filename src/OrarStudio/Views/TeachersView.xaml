<UserControl x:Class="OrarStudio.Views.TeachersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:OrarStudio.UI"
             xmlns:vm="clr-namespace:OrarStudio.ViewModels"
             xmlns:m="clr-namespace:OrarStudio.Models">
    <UserControl.Resources>
        <Style x:Key="AvailCell" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Margin="2" Height="26" CornerRadius="6" Background="{DynamicResource Brush.SuccessSoft}"
                                BorderBrush="Transparent" BorderThickness="1">
                            <TextBlock x:Name="Ico" Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="10" Foreground="{DynamicResource Brush.Success}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Brush.DangerSoft}"/>
                                <Setter TargetName="Ico" Property="Text" Value="&#xE711;"/>
                                <Setter TargetName="Ico" Property="Foreground" Value="{DynamicResource Brush.Danger}"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20,16,20,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource Card}" Padding="0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="18,16,18,14">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Primary}" ui:Ui.Icon="&#xE710;" Content="Profesor nou" Command="{Binding AddCommand}"/>
                    <TextBox DockPanel.Dock="Right" Width="260" Margin="0,0,10,0" ui:Ui.Icon="&#xE721;" ui:Ui.Placeholder="Caută nume, titlu, departament…"
                             Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Cadre didactice" Style="{StaticResource Text.H3}"/>
                        <TextBlock Text="{Binding CountText}" Style="{StaticResource Text.Muted}"/>
                    </StackPanel>
                </DockPanel>
                <DataGrid ItemsSource="{Binding ItemsView}" SelectedItem="{Binding Selected}" CanUserSortColumns="True" BorderThickness="0,1,0,0"
                          BorderBrush="{DynamicResource Brush.Border}" MouseDoubleClick="Grid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Nume" Width="1.4*" SortMemberPath="Name">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type m:Teacher}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="28" Height="28" CornerRadius="14" Background="{DynamicResource Brush.AccentSoft}" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Name, Converter={StaticResource Initials}}" FontSize="11" FontWeight="Bold"
                                                       Foreground="{DynamicResource Brush.AccentSoftText}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Titlul" Binding="{Binding Title}" Width="1.2*"/>
                        <DataGridTextColumn Header="Departament" Binding="{Binding Department}" Width="*"/>
                        <DataGridTextColumn Header="Ore în orar" Binding="{Binding HoursScheduled}" Width="92"/>
                        <DataGridTextColumn Header="Planificat" Binding="{Binding HoursPlanned}" Width="86"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0" Width="430" Margin="16,0,0,0" Visibility="{Binding HasDraft, Converter={StaticResource BoolToVis}}">
            <Grid>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="30" Visibility="{Binding HasDraft, Converter={StaticResource BoolToVisInv}}">
                    <Border Width="56" Height="56" CornerRadius="28" Background="{DynamicResource Brush.AccentSoft}">
                        <TextBlock Text="&#xE77B;" Style="{StaticResource Icon}" FontSize="22" Foreground="{DynamicResource Brush.Accent}"/>
                    </Border>
                    <TextBlock Text="Selectați un profesor" Style="{StaticResource Text.H3}" HorizontalAlignment="Center" Margin="0,14,0,4"/>
                    <TextBlock Text="Aici setați și doleanțele (intervalele indisponibile)." Style="{StaticResource Text.Muted}" HorizontalAlignment="Center"/>
                </StackPanel>
                <DockPanel Visibility="{Binding HasDraft, Converter={StaticResource BoolToVis}}">
                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="18,12">
                        <DockPanel>
                            <Button DockPanel.Dock="Left" Style="{StaticResource Btn.Danger}" ui:Ui.Icon="&#xE74D;" Content="Șterge" Command="{Binding DeleteCommand}"
                                    Visibility="{Binding IsNew, Converter={StaticResource BoolToVisInv}}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Anulează" Command="{Binding CancelCommand}" Margin="0,0,8,0"/>
                                <Button Style="{StaticResource Btn.Primary}" ui:Ui.Icon="&#xE74E;" Content="Salvează" Command="{Binding SaveCommand}" IsDefault="True"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20,18,20,18">
                            <TextBlock Text="{Binding FormTitle}" Style="{StaticResource Text.H2}"/>
                            <TextBlock Text="{Binding TeacherInfo}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                            <Button Style="{StaticResource Btn.Link}" Content="Deschide orarul profesorului →" Command="{Binding OpenScheduleCommand}" Margin="0,4,0,14"
                                    HorizontalAlignment="Left" Visibility="{Binding IsNew, Converter={StaticResource BoolToVisInv}}"/>

                            <TextBlock Text="Numele (cum apare în orar)" Style="{StaticResource Text.Label}"/>
                            <TextBox Text="{Binding Draft.Name, UpdateSourceTrigger=PropertyChanged}" ui:Ui.Placeholder="ex. V. Arnaut"/>
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Titlul științific / didactic" Style="{StaticResource Text.Label}"/>
                                    <TextBox Text="{Binding Draft.Title, UpdateSourceTrigger=PropertyChanged}" ui:Ui.Placeholder="dr., conf. univ."/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Departamentul" Style="{StaticResource Text.Label}"/>
                                    <TextBox Text="{Binding Draft.Department, UpdateSourceTrigger=PropertyChanged}" ui:Ui.Placeholder="Informatică"/>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="E-mail" Style="{StaticResource Text.Label}"/>
                                    <TextBox Text="{Binding Draft.Email, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Telefon" Style="{StaticResource Text.Label}"/>
                                    <TextBox Text="{Binding Draft.Phone, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>

                            <DockPanel Margin="0,20,0,8">
                                <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Ghost}" Content="Golește" Command="{Binding ClearAvailabilityCommand}" Padding="8,3" MinHeight="28"/>
                                <StackPanel>
                                    <TextBlock Text="Doleanțe — disponibilitate" Style="{StaticResource Text.H3}"/>
                                    <TextBlock Text="Clic pe un interval pentru a-l marca indisponibil (✕)." Style="{StaticResource Text.Muted}"/>
                                </StackPanel>
                            </DockPanel>
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Margin="44,0,0,2">
                                    <ItemsControl ItemsSource="{Binding DayHeaders}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" HorizontalAlignment="Center" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                                <ItemsControl Grid.Row="1" ItemsSource="{Binding Availability}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:AvailabilityRow}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="44"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Label}" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource Brush.Accent}"/>
                                                    <TextBlock Text="{Binding Time}" FontSize="10" Foreground="{DynamicResource Brush.TextMuted}"/>
                                                </StackPanel>
                                                <ItemsControl Grid.Column="1" ItemsSource="{Binding Cells}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:AvailabilityCell}">
                                                            <ToggleButton Style="{StaticResource AvailCell}" IsChecked="{Binding IsBlocked}" ToolTip="{Binding Tooltip}"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>

                            <TextBlock Text="Activitățile profesorului" Style="{StaticResource Text.H3}" Margin="0,20,0,6"
                                       Visibility="{Binding TeacherActivities.Count, Converter={StaticResource CountToVis}}"/>
                            <ItemsControl ItemsSource="{Binding TeacherActivities}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding}" FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" Margin="0,2"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Note" Style="{StaticResource Text.Label}" Margin="0,16,0,6"/>
                            <TextBox Style="{StaticResource Input.Multiline}" Text="{Binding Draft.Notes, UpdateSourceTrigger=PropertyChanged}"/>

                            <Border Background="{DynamicResource Brush.DangerSoft}" CornerRadius="8" Padding="12,9" Margin="0,14,0,0"
                                    Visibility="{Binding ValidationError, Converter={StaticResource NullToVis}}">
                                <TextBlock Text="{Binding ValidationError}" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
