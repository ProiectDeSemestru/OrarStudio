<UserControl x:Class="OrarStudio.Views.TimetableView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:OrarStudio.UI"
             xmlns:vm="clr-namespace:OrarStudio.ViewModels"
             xmlns:m="clr-namespace:OrarStudio.Models"
             Focusable="True" FocusVisualStyle="{x:Null}" AllowDrop="True"
             PreviewKeyDown="View_PreviewKeyDown">

    <UserControl.Resources>
        <!-- ─────────── Cartonașul unei lecții ─────────── -->
        <DataTemplate x:Key="CardTemplate" DataType="{x:Type vm:LessonCardVM}">
            <Border x:Name="Card" CornerRadius="8" Margin="1.5" Background="{DynamicResource Brush.CursSoft}"
                    BorderBrush="Transparent" BorderThickness="1.5" Cursor="Hand" ClipToBounds="True" Tag="{Binding}"
                    ToolTip="{Binding Tooltip}" ToolTipService.InitialShowDelay="550" ToolTipService.ShowDuration="30000"
                    MouseLeftButtonDown="Card_MouseLeftButtonDown" MouseMove="Card_MouseMove" MouseRightButtonUp="Card_MouseRightButtonUp">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="Strip" Background="{DynamicResource Brush.Curs}" CornerRadius="6,0,0,6"/>
                    <StackPanel Grid.Column="1" Margin="7,5,6,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="TitleText" Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap"
                                       MaxHeight="31" LineStackingStrategy="BlockLineHeight" LineHeight="15" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource Brush.Text}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="4,1,0,0">
                                <TextBlock x:Name="LockIcon" Text="&#xE72E;" Style="{StaticResource Icon}" FontSize="10" Foreground="{DynamicResource Brush.TextMuted}" Visibility="Collapsed"/>
                                <TextBlock x:Name="IssueIcon" Text="&#xE783;" Style="{StaticResource Icon}" FontSize="11" Margin="3,0,0,0" Foreground="{DynamicResource Brush.Danger}" Visibility="Collapsed"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="Line2" Text="{Binding Line2}" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                        <WrapPanel x:Name="Chips" Margin="0,4,0,0">
                            <Border Style="{StaticResource Chip}" Background="{DynamicResource Brush.Surface}" Padding="5,1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE825;" Style="{StaticResource Icon}" FontSize="9" Foreground="{DynamicResource Brush.TextMuted}" Margin="0,0,4,0"/>
                                    <TextBlock Text="{Binding Room}" Style="{StaticResource ChipText}" Foreground="{DynamicResource Brush.Text}"/>
                                </StackPanel>
                            </Border>
                            <Border x:Name="TypeChip" Style="{StaticResource Chip}" Background="{DynamicResource Brush.Surface}" Padding="5,1">
                                <TextBlock Text="{Binding TypeLabel}" Style="{StaticResource ChipText}"/>
                            </Border>
                            <Border Style="{StaticResource Chip}" Background="{DynamicResource Brush.Surface}" Padding="5,1"
                                    Visibility="{Binding Badge, Converter={StaticResource NullToVis}}">
                                <TextBlock Text="{Binding Badge}" Style="{StaticResource ChipText}"/>
                            </Border>
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Type}" Value="{x:Static m:LessonType.Seminar}">
                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource Brush.SeminarSoft}"/>
                    <Setter TargetName="Strip" Property="Background" Value="{DynamicResource Brush.Seminar}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="{x:Static m:LessonType.Laborator}">
                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource Brush.LabSoft}"/>
                    <Setter TargetName="Strip" Property="Background" Value="{DynamicResource Brush.Lab}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding ColorBySubject}" Value="True">
                    <Setter TargetName="Strip" Property="Background" Value="{Binding SubjectColor, Converter={StaticResource HexToBrush}}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Compact}" Value="True">
                    <Setter TargetName="TitleText" Property="MaxHeight" Value="15"/>
                    <Setter TargetName="TitleText" Property="FontSize" Value="11.5"/>
                    <Setter TargetName="TypeChip" Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Mini}" Value="True">
                    <Setter TargetName="Chips" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="Line2" Property="FontSize" Value="10.5"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Locked}" Value="True">
                    <Setter TargetName="LockIcon" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HasWarning}" Value="True">
                    <Setter TargetName="IssueIcon" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="IssueIcon" Property="Text" Value="&#xE7BA;"/>
                    <Setter TargetName="IssueIcon" Property="Foreground" Value="{DynamicResource Brush.Warning}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding HasError}" Value="True">
                    <Setter TargetName="IssueIcon" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.Danger}"/>
                </DataTrigger>
                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}"/>
                </Trigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                    <Setter TargetName="Card" Property="BorderThickness" Value="2"/>
                    <Setter TargetName="Card" Property="Effect" Value="{StaticResource Shadow.Raised}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- ─────────── Coloană din celulă: săptămânal sau „fracție" impar/par ─────────── -->
        <DataTemplate DataType="{x:Type vm:CellColumnVM}">
            <Grid>
                <ContentControl Focusable="False" IsTabStop="False" Content="{Binding Full}" ContentTemplate="{StaticResource CardTemplate}"
                                  Visibility="{Binding Full, Converter={StaticResource NullToVis}}"/>
                <Grid Visibility="{Binding IsSplit, Converter={StaticResource BoolToVis}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Border Margin="1.5" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}"
                            Visibility="{Binding Odd, Converter={StaticResource NullToVisInv}}">
                        <TextBlock Text="impar · liber" FontSize="10.5" Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ContentControl Focusable="False" IsTabStop="False" Content="{Binding Odd}" ContentTemplate="{StaticResource CardTemplate}"
                                      Visibility="{Binding Odd, Converter={StaticResource NullToVis}}"/>
                    <Border Grid.Row="1" Margin="1.5" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource Brush.Border}"
                            Visibility="{Binding Even, Converter={StaticResource NullToVisInv}}">
                        <TextBlock Text="par · liber" FontSize="10.5" Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ContentControl Focusable="False" IsTabStop="False" Grid.Row="1" Content="{Binding Even}" ContentTemplate="{StaticResource CardTemplate}"
                                      Visibility="{Binding Even, Converter={StaticResource NullToVis}}"/>
                    <Border Grid.RowSpan="2" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0" CornerRadius="4"
                            Background="{DynamicResource Brush.Surface}" Padding="3,0" IsHitTestVisible="False" Opacity="0.9">
                        <TextBlock Text="i / p" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Brush.TextMuted}"/>
                    </Border>
                </Grid>
            </Grid>
        </DataTemplate>

        <!-- ─────────── Celulă (zi × pereche) ─────────── -->
        <DataTemplate DataType="{x:Type vm:CellVM}">
            <Border x:Name="CellBorder" Margin="3" CornerRadius="10" Background="{DynamicResource Brush.SurfaceAlt}"
                    BorderBrush="{DynamicResource Brush.GridLine}" BorderThickness="1" AllowDrop="True" Tag="{Binding}" MinHeight="92"
                    DragEnter="Cell_DragOver" DragOver="Cell_DragOver" Drop="Cell_Drop"
                    MouseLeftButtonDown="Cell_MouseLeftButtonDown" MouseRightButtonUp="Cell_MouseRightButtonUp">
                <Grid>
                    <TextBlock x:Name="AddHint" Text="&#xE710;" Style="{StaticResource Icon}" FontSize="14" Foreground="{DynamicResource Brush.TextMuted}"
                               Visibility="Collapsed" IsHitTestVisible="False"/>
                    <TextBlock x:Name="Blocked" Text="indisponibil" FontSize="11" FontStyle="Italic" Foreground="{DynamicResource Brush.TextMuted}"
                               HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,6" Visibility="Collapsed" IsHitTestVisible="False"/>
                    <ItemsControl ItemsSource="{Binding Columns}" Margin="2" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Compact}" Value="True">
                    <Setter TargetName="CellBorder" Property="MinHeight" Value="0"/>
                    <Setter TargetName="CellBorder" Property="Margin" Value="2"/>
                    <Setter TargetName="CellBorder" Property="CornerRadius" Value="8"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsToday}" Value="True">
                    <Setter TargetName="CellBorder" Property="Background" Value="{DynamicResource Brush.Today}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsUnavailable}" Value="True">
                    <Setter TargetName="CellBorder" Property="Background" Value="{DynamicResource Brush.Hatch}"/>
                    <Setter TargetName="Blocked" Property="Visibility" Value="Visible"/>
                </DataTrigger>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMouseOver, ElementName=CellBorder}" Value="True"/>
                        <Condition Binding="{Binding HasLessons}" Value="False"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="AddHint" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="CellBorder" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}"/>
                </MultiDataTrigger>
                <DataTrigger Binding="{Binding DropState}" Value="{x:Static vm:DropState.Ok}">
                    <Setter TargetName="CellBorder" Property="Background" Value="{DynamicResource Brush.DropOk}"/>
                    <Setter TargetName="CellBorder" Property="BorderBrush" Value="{DynamicResource Brush.Success}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding DropState}" Value="{x:Static vm:DropState.Warn}">
                    <Setter TargetName="CellBorder" Property="Background" Value="{DynamicResource Brush.DropWarn}"/>
                    <Setter TargetName="CellBorder" Property="BorderBrush" Value="{DynamicResource Brush.Warning}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding DropState}" Value="{x:Static vm:DropState.Bad}">
                    <Setter TargetName="CellBorder" Property="Background" Value="{DynamicResource Brush.DropBad}"/>
                    <Setter TargetName="CellBorder" Property="BorderBrush" Value="{DynamicResource Brush.Danger}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsDropTarget}" Value="True">
                    <Setter TargetName="CellBorder" Property="BorderThickness" Value="2.5"/>
                    <Setter TargetName="CellBorder" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:CornerVM}">
            <Border/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:DayHeaderVM}">
            <Border x:Name="B" Margin="3,0,3,4" Padding="12,7" CornerRadius="10">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13.5"/>
                        <Border x:Name="TodayChip" Visibility="Collapsed" Background="{DynamicResource Brush.Accent}" CornerRadius="6" Padding="6,0,6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="azi" Foreground="White" FontSize="10.5" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding Load}" FontSize="11.5" Foreground="{DynamicResource Brush.TextMuted}"/>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsToday}" Value="True">
                    <Setter TargetName="TodayChip" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="B" Property="Background" Value="{DynamicResource Brush.AccentSoft}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:SlotHeaderVM}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,4,0">
                <TextBlock Text="{Binding Roman}" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding Start}" FontSize="11.5" Foreground="{DynamicResource Brush.TextSecondary}" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding End}" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Center"/>
            </StackPanel>
        </DataTemplate>

        <!-- ─────────── Vizualizarea „Toate …": antetul coloanei, ziua, perechea ─────────── -->
        <DataTemplate DataType="{x:Type vm:EntityHeaderVM}">
            <Border x:Name="Head" Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,1"
                    Padding="6,4" Cursor="Hand" Tag="{Binding}" ToolTip="{Binding Tooltip}" MouseLeftButtonDown="EntityHeader_MouseLeftButtonDown">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Label}" FontWeight="Bold" FontSize="12.5" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource Brush.Text}"/>
                    <TextBlock Text="{Binding Detail}" FontSize="10.5" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource Brush.TextMuted}"/>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="Head" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Head" Property="Background" Value="{DynamicResource Brush.AccentSoft}"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:MatrixDayVM}">
            <Border Background="{DynamicResource Brush.AccentSoft}" BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="0,0,1,2">
                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="11.5" Foreground="{DynamicResource Brush.AccentSoftText}"
                           VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock.LayoutTransform>
                        <RotateTransform Angle="-90"/>
                    </TextBlock.LayoutTransform>
                </TextBlock>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:MatrixSlotVM}">
            <Border x:Name="B" BorderBrush="{DynamicResource Brush.GridLine}" BorderThickness="0,0,1,1">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Roman}" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource Brush.Accent}" HorizontalAlignment="Center"/>
                    <TextBlock Text="{Binding Time}" FontSize="10" Foreground="{DynamicResource Brush.TextMuted}" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding LastOfDay}" Value="True">
                    <Setter TargetName="B" Property="BorderThickness" Value="0,0,1,2"/>
                    <Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="MatrixItem" TargetType="ContentPresenter">
            <Setter Property="Grid.Row" Value="{Binding Row}"/>
            <Setter Property="Grid.Column" Value="{Binding Col}"/>
            <Setter Property="Grid.RowSpan" Value="{Binding RowSpan}"/>
            <Setter Property="Grid.ColumnSpan" Value="{Binding ColSpan}"/>
        </Style>

        <!-- ─────────── Activitate de plasat (panoul din stânga) ─────────── -->
        <DataTemplate DataType="{x:Type vm:ActivityItemVM}">
            <Border x:Name="Card" Padding="10,9" CornerRadius="10" Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1" Cursor="Hand" Tag="{Binding}" ToolTip="{Binding Tooltip}" ToolTipService.InitialShowDelay="700"
                    MouseLeftButtonDown="Activity_MouseLeftButtonDown" MouseMove="Activity_MouseMove" MouseRightButtonUp="Activity_MouseRightButtonUp">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="4"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border x:Name="Strip" CornerRadius="2" Background="{DynamicResource Brush.Curs}"/>
                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12.5" TextWrapping="Wrap"/>
                        <TextBlock FontSize="11.5" Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,2,0,0">
                            <Run Text="{Binding TypeLabel, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" · "/><Run Text="{Binding Hours, Mode=OneWay}"/><Run Text=" ore/săpt."/>
                        </TextBlock>
                        <TextBlock Text="{Binding Groups}" FontSize="11.5" Foreground="{DynamicResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Teacher}" FontSize="11.5" Foreground="{DynamicResource Brush.TextMuted}" TextTrimming="CharacterEllipsis"/>
                        <Grid Margin="0,7,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ProgressBar x:Name="Bar" Maximum="1" Value="{Binding Progress, Mode=OneWay}" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding ProgressText}" FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}" Margin="8,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Type}" Value="{x:Static m:LessonType.Seminar}">
                    <Setter TargetName="Strip" Property="Background" Value="{DynamicResource Brush.Seminar}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Type}" Value="{x:Static m:LessonType.Laborator}">
                    <Setter TargetName="Strip" Property="Background" Value="{DynamicResource Brush.Lab}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsComplete}" Value="True">
                    <Setter TargetName="Card" Property="Opacity" Value="0.62"/>
                    <Setter TargetName="Bar" Property="Foreground" Value="{DynamicResource Brush.Success}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsOver}" Value="True">
                    <Setter TargetName="Bar" Property="Foreground" Value="{DynamicResource Brush.Warning}"/>
                </DataTrigger>
                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="RootGrid" Margin="20,16,20,14" PreviewDragOver="Root_PreviewDragOver" DragOver="Root_DragOver" Background="Transparent">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ═════════ Panoul „De plasat" ═════════ -->
        <Border x:Name="PendingPanel" Style="{StaticResource Card}" Padding="0" AllowDrop="True" DragOver="Pending_DragOver" Drop="Pending_Drop">
            <Grid>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="16,14,16,8">
                        <TextBlock Text="De plasat în orar" Style="{StaticResource Text.H3}"/>
                        <TextBlock Text="{Binding PendingSummary}" Style="{StaticResource Text.Secondary}" Margin="0,2,0,10"/>
                        <TextBox ui:Ui.Icon="&#xE721;" ui:Ui.Placeholder="Caută disciplină, grupă, profesor…"
                                 Text="{Binding PendingSearch, UpdateSourceTrigger=PropertyChanged}"/>
                        <CheckBox Content="Afișează și activitățile complete" IsChecked="{Binding ShowCompleted}" Margin="2,10,0,0" FontSize="12"/>
                    </StackPanel>

                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="16,10,16,12"
                            Visibility="{Binding Issues.Count, Converter={StaticResource CountToVis}}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource Brush.Warning}" Margin="0,0,6,0"/>
                                <TextBlock Text="Probleme în această vizualizare" Style="{StaticResource Text.H3}" FontSize="12.5"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding Issues}" MaxHeight="150">
                                <ItemsControl.Template>
                                    <ControlTemplate TargetType="ItemsControl">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter/></ScrollViewer>
                                    </ControlTemplate>
                                </ItemsControl.Template>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:IssueVM}">
                                        <Button Style="{StaticResource Btn.Ghost}" HorizontalContentAlignment="Stretch" Padding="6,4" MinHeight="0" FontWeight="Normal"
                                                Command="{Binding DataContext.IssueClickCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="16"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="I" Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="10" Foreground="{DynamicResource Brush.Warning}" VerticalAlignment="Top" Margin="0,3,0,0"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Message}" FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource Brush.Text}"/>
                                                    <TextBlock Text="{Binding Where}" FontSize="10.5" Foreground="{DynamicResource Brush.TextMuted}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                                <Setter TargetName="I" Property="Text" Value="&#xE783;"/>
                                                <Setter TargetName="I" Property="Foreground" Value="{DynamicResource Brush.Danger}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <ListBox ItemsSource="{Binding Pending}" Style="{StaticResource PlainList}" Padding="12,4,12,8">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource ListItem}">
                                <Setter Property="Margin" Value="0,0,0,8"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <ContentPresenter/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </DockPanel>
                <!-- zonă de eliberare la tragerea unei lecții -->
                <Border x:Name="RemoveZone" CornerRadius="14" Background="{DynamicResource Brush.DangerSoft}" BorderBrush="{DynamicResource Brush.Danger}"
                        BorderThickness="2" Visibility="Collapsed" IsHitTestVisible="False" Opacity="0.95">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE74D;" Style="{StaticResource Icon}" FontSize="26" Foreground="{DynamicResource Brush.Danger}"/>
                        <TextBlock Text="Eliberați aici pentru a scoate&#x0a;lecția din orar" TextAlignment="Center" Margin="0,10,0,0"
                                   FontWeight="SemiBold" Foreground="{DynamicResource Brush.Danger}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ═════════ Grila orarului ═════════ -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ListBox Style="{StaticResource Segmented}" ItemsSource="{Binding Modes}" SelectedValuePath="Value" SelectedValue="{Binding Mode}" VerticalAlignment="Center">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Icon}" Style="{StaticResource Icon}" FontSize="13" Margin="0,0,7,0"/>
                                <TextBlock Text="{Binding Label}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <Button Style="{StaticResource Btn.Icon}" ui:Ui.Icon="&#xE76B;" Command="{Binding PrevEntityCommand}" ToolTip="Precedentul (PgUp)"/>
                    <ComboBox Width="250" ItemsSource="{Binding Entities}" SelectedItem="{Binding SelectedEntity}" IsTextSearchEnabled="True"
                              TextSearch.TextPath="Label" MaxDropDownHeight="460" Margin="4,0">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:EntityOption}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="AllIcon" Text="&#xE71D;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource Brush.Accent}"
                                               Margin="0,0,7,0" Visibility="Collapsed"/>
                                    <TextBlock x:Name="LabelText" Text="{Binding Label}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Brush.TextMuted}" Margin="8,0,0,0" FontSize="12" TextTrimming="CharacterEllipsis" MaxWidth="180"/>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsAll}" Value="True">
                                        <Setter TargetName="AllIcon" Property="Visibility" Value="Visible"/>
                                        <Setter TargetName="LabelText" Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Style="{StaticResource Btn.Icon}" ui:Ui.Icon="&#xE76C;" Command="{Binding NextEntityCommand}" ToolTip="Următorul (PgDn)"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Btn.Ghost}" ui:Ui.Icon="&#xE945;" Content="Plasează" Command="{Binding AutoPlaceEntityCommand}"
                            ToolTip="Plasează automat activitățile nealocate ale selecției curente"/>
                    <Button Style="{StaticResource Btn.Icon}" ui:Ui.Icon="&#xE74D;" Command="{Binding ClearEntityCommand}"
                            ToolTip="Golește: scoate din orar lecțiile neblocate ale selecției curente" Margin="2,0,8,0"/>
                    <Button ui:Ui.Icon="&#xE8A5;" Content="PDF" Command="{Binding ExportPdfCommand}" ToolTip="Exportă orarul afișat în PDF"/>
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10,10,6,6"
                    Visibility="{Binding IsMatrix, Converter={StaticResource BoolToVisInv}}">
                <ScrollViewer x:Name="GridScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Focusable="False">
                    <ItemsControl ItemsSource="{Binding GridItems}" Focusable="False" HorizontalAlignment="Left"
                                  MinHeight="{Binding ViewportHeight, ElementName=GridScroll}">
                        <ItemsControl.Width>
                            <MultiBinding Converter="{StaticResource Max}">
                                <Binding Path="ViewportWidth" ElementName="GridScroll"/>
                                <Binding Path="GridMinWidth"/>
                            </MultiBinding>
                        </ItemsControl.Width>
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <Grid ui:GridDefs.Columns="{Binding ColumnSpec}" ui:GridDefs.Rows="{Binding RowSpec}"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemContainerStyle>
                            <Style TargetType="ContentPresenter">
                                <Setter Property="Grid.Row" Value="{Binding Row}"/>
                                <Setter Property="Grid.Column" Value="{Binding Col}"/>
                            </Style>
                        </ItemsControl.ItemContainerStyle>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

            <!-- ═════════ „Toate grupele / profesorii / auditoriile": rânduri = zi × pereche, coloane = entități ═════════ -->
            <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" ClipToBounds="True"
                    Visibility="{Binding IsMatrix, Converter={StaticResource BoolToVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="110" Height="52" Background="{DynamicResource Brush.SurfaceAlt}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,1">
                        <TextBlock Text="Zi / pereche" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextSecondary}"
                                   VerticalAlignment="Center" HorizontalAlignment="Center"/>
                    </Border>
                    <ScrollViewer x:Name="MatrixHeaderScroll" Grid.Column="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Focusable="False">
                        <ItemsControl ItemsSource="{Binding MatrixHeaderItems}" Focusable="False" Margin="0,0,18,0" HorizontalAlignment="Left"
                                      ItemContainerStyle="{StaticResource MatrixItem}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Grid ui:GridDefs.Columns="{Binding MatrixColumnSpec}" Height="52"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                    <ScrollViewer x:Name="MatrixLeftScroll" Grid.Row="1" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <ItemsControl ItemsSource="{Binding MatrixLeftItems}" Focusable="False" Margin="0,0,0,18" VerticalAlignment="Top"
                                      ItemContainerStyle="{StaticResource MatrixItem}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Grid ui:GridDefs.Columns="36 74" ui:GridDefs.Rows="{Binding MatrixRowSpec}"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                    <ScrollViewer x:Name="MatrixBodyScroll" Grid.Row="1" Grid.Column="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  ScrollChanged="MatrixBody_ScrollChanged" Focusable="False">
                        <ItemsControl ItemsSource="{Binding MatrixCellItems}" Focusable="False" HorizontalAlignment="Left" VerticalAlignment="Top"
                                      ItemContainerStyle="{StaticResource MatrixItem}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Grid ui:GridDefs.Columns="{Binding MatrixColumnSpec}" ui:GridDefs.Rows="{Binding MatrixRowSpec}"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <DockPanel Grid.Row="2" Margin="4,10,4,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="12" Height="12" CornerRadius="3" Background="{DynamicResource Brush.Curs}" Margin="0,0,6,0"/>
                    <TextBlock Text="Curs" Style="{StaticResource Text.Muted}" Margin="0,0,14,0"/>
                    <Border Width="12" Height="12" CornerRadius="3" Background="{DynamicResource Brush.Seminar}" Margin="0,0,6,0"/>
                    <TextBlock Text="Seminar" Style="{StaticResource Text.Muted}" Margin="0,0,14,0"/>
                    <Border Width="12" Height="12" CornerRadius="3" Background="{DynamicResource Brush.Lab}" Margin="0,0,6,0"/>
                    <TextBlock Text="Laborator" Style="{StaticResource Text.Muted}" Margin="0,0,14,0"/>
                    <Border Width="12" Height="12" CornerRadius="3" Background="{DynamicResource Brush.Hatch}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Margin="0,0,6,0"/>
                    <TextBlock Text="Indisponibil (doleanțe)" Style="{StaticResource Text.Muted}" Margin="0,0,14,0"/>
                    <TextBlock Text="i / p = săptămâni impare / pare" Style="{StaticResource Text.Muted}"/>
                </StackPanel>
                <TextBlock HorizontalAlignment="Right" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="16,0,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Muted}">
                            <Setter Property="Text" Value="Dublu-clic: editare / lecție nouă · trageți pentru a muta · clic dreapta: meniu · Del: ștergere · Alt+săgeți: mutare"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsDragging}" Value="True">
                                    <Setter Property="Text" Value="{Binding DragHint}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
