<UserControl x:Class="OrarStudio.Views.GroupsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:OrarStudio.UI"
             xmlns:m="clr-namespace:OrarStudio.Models">
    <Grid Margin="20,16,20,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource Card}" Padding="0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="18,16,18,14">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Primary}" ui:Ui.Icon="&#xE710;" Content="Grupă nouă" Command="{Binding AddCommand}"/>
                    <TextBox DockPanel.Dock="Right" Width="260" Margin="0,0,10,0" ui:Ui.Icon="&#xE721;" ui:Ui.Placeholder="Caută cod sau specialitate…"
                             Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Grupe academice" Style="{StaticResource Text.H3}"/>
                        <TextBlock Text="{Binding CountText}" Style="{StaticResource Text.Muted}"/>
                    </StackPanel>
                </DockPanel>
                <DataGrid ItemsSource="{Binding ItemsView}" SelectedItem="{Binding Selected}" CanUserSortColumns="True" BorderThickness="0,1,0,0"
                          BorderBrush="{DynamicResource Brush.Border}" MouseDoubleClick="Grid_MouseDoubleClick">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Cod" Binding="{Binding Code}" Width="100" FontWeight="SemiBold"/>
                        <DataGridTextColumn Header="Specialitatea" Binding="{Binding Specialty}" Width="2*"/>
                        <DataGridTextColumn Header="Anul" Binding="{Binding Year}" Width="56"/>
                        <DataGridTextColumn Header="Ciclul" Binding="{Binding Cycle}" Width="80"/>
                        <DataGridTextColumn Header="Limba" Binding="{Binding Language, Converter={StaticResource EnumLabel}}" Width="80"/>
                        <DataGridTextColumn Header="Studenți" Binding="{Binding Students}" Width="76"/>
                        <DataGridTextColumn Header="Subgrupe" Binding="{Binding SubgroupsLabel}" Width="*"/>
                        <DataGridTextColumn Header="Ore/săpt." Binding="{Binding HoursScheduled}" Width="80"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0" Width="400" Margin="16,0,0,0" Visibility="{Binding HasDraft, Converter={StaticResource BoolToVis}}">
            <Grid>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="30" Visibility="{Binding HasDraft, Converter={StaticResource BoolToVisInv}}">
                    <Border Width="56" Height="56" CornerRadius="28" Background="{DynamicResource Brush.AccentSoft}">
                        <TextBlock Text="&#xE716;" Style="{StaticResource Icon}" FontSize="22" Foreground="{DynamicResource Brush.Accent}"/>
                    </Border>
                    <TextBlock Text="Selectați o grupă" Style="{StaticResource Text.H3}" HorizontalAlignment="Center" Margin="0,14,0,4"/>
                    <TextBlock Text="Dublu-clic pe o grupă deschide orarul ei." Style="{StaticResource Text.Muted}" HorizontalAlignment="Center"/>
                </StackPanel>
                <DockPanel Visibility="{Binding HasDraft, Converter={StaticResource BoolToVis}}">
                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="18,12">
                        <DockPanel>
                            <Button DockPanel.Dock="Left" Style="{StaticResource Btn.Danger}" ui:Ui.Icon="&#xE74D;" Content="Șterge" Command="{Binding DeleteCommand}"
                                    Visibility="{Binding IsNew, Converter={StaticResource BoolToVisInv}}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Anulează" Command="{Binding CancelCommand}" Margin="0,0,8,0"/>
                                <Button Style="{StaticResource Btn.Primary}" ui:Ui.Icon="&#xE74E;" Content="Salvează" Command="{Binding SaveCommand}" IsDefault="True"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20,18,20,18">
                            <TextBlock Text="{Binding FormTitle}" Style="{StaticResource Text.H2}"/>
                            <Button Style="{StaticResource Btn.Link}" Content="Deschide orarul grupei →" Command="{Binding OpenScheduleCommand}" Margin="0,4,0,14"
                                    HorizontalAlignment="Left" Visibility="{Binding IsNew, Converter={StaticResource BoolToVisInv}}"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Codul grupei" Style="{StaticResource Text.Label}"/>
                                    <TextBox Text="{Binding Draft.Code, UpdateSourceTrigger=PropertyChanged}" ui:Ui.Placeholder="ex. I2301" CharacterCasing="Upper"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Numărul de studenți" Style="{StaticResource Text.Label}"/>
                                    <TextBox Text="{Binding Draft.Students, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Specialitatea" Style="{StaticResource Text.Label}" Margin="0,14,0,6"/>
                            <TextBox Text="{Binding Draft.Specialty, UpdateSourceTrigger=PropertyChanged}" ui:Ui.Placeholder="ex. Informatica Aplicată"/>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Anul de studii" Style="{StaticResource Text.Label}"/>
                                    <ComboBox ItemsSource="{Binding Years}" SelectedItem="{Binding Draft.Year}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Ciclul" Style="{StaticResource Text.Label}"/>
                                    <ComboBox ItemsSource="{Binding Cycles}" SelectedItem="{Binding Draft.Cycle}"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Limba de instruire" Style="{StaticResource Text.Label}" Margin="0,14,0,6"/>
                            <ListBox Style="{StaticResource Segmented}" ItemsSource="{Binding Languages}" SelectedItem="{Binding Draft.Language}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumLabel}}"/></DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <DockPanel Margin="0,18,0,8">
                                <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Soft}" ui:Ui.Icon="&#xE710;" Content="Subgrupă" Command="{Binding AddSubgroupCommand}"
                                        Padding="10,4" MinHeight="30"/>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Subgrupe" Style="{StaticResource Text.H3}"/>
                                    <TextBlock Text="Pentru laboratoare (ex. I2301-1) sau trasee (ex. IA2101-SC)" Style="{StaticResource Text.Muted}"/>
                                </StackPanel>
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Draft.Subgroups}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type m:Subgroup}">
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" CharacterCasing="Upper"/>
                                            <TextBox Grid.Column="1" Text="{Binding Students, UpdateSourceTrigger=PropertyChanged}" Margin="8,0,0,0" ToolTip="Numărul de studenți"/>
                                            <Button Grid.Column="2" Style="{StaticResource Btn.Icon}" ui:Ui.Icon="&#xE74D;" Margin="4,0,0,0" ToolTip="Elimină subgrupa"
                                                    Command="{Binding DataContext.RemoveSubgroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Note" Style="{StaticResource Text.Label}" Margin="0,10,0,6"/>
                            <TextBox Style="{StaticResource Input.Multiline}" Text="{Binding Draft.Notes, UpdateSourceTrigger=PropertyChanged}"/>

                            <Border Background="{DynamicResource Brush.DangerSoft}" CornerRadius="8" Padding="12,9" Margin="0,14,0,0"
                                    Visibility="{Binding ValidationError, Converter={StaticResource NullToVis}}">
                                <TextBlock Text="{Binding ValidationError}" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
