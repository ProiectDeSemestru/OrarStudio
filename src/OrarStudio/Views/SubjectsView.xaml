<UserControl x:Class="OrarStudio.Views.SubjectsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:OrarStudio.UI"
             xmlns:m="clr-namespace:OrarStudio.Models">
    <Grid Margin="20,16,20,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>

        <Border Style="{StaticResource Card}" Padding="0">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="18,16,18,14">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Primary}" ui:Ui.Icon="&#xE710;" Content="Disciplină nouă" Command="{Binding AddCommand}"/>
                    <TextBox DockPanel.Dock="Right" Width="260" Margin="0,0,10,0" ui:Ui.Icon="&#xE721;" ui:Ui.Placeholder="Caută disciplină…"
                             Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Discipline (obiecte de studiu)" Style="{StaticResource Text.H3}"/>
                        <TextBlock Text="{Binding CountText}" Style="{StaticResource Text.Muted}"/>
                    </StackPanel>
                </DockPanel>
                <DataGrid ItemsSource="{Binding ItemsView}" SelectedItem="{Binding Selected}" CanUserSortColumns="True" BorderThickness="0,1,0,0"
                          BorderBrush="{DynamicResource Brush.Border}">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Denumirea" Width="3*" SortMemberPath="Name">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type m:Subject}">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="12" Height="12" CornerRadius="4" Background="{Binding Color, Converter={StaticResource HexToBrush}}" Margin="0,0,10,0"/>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Abreviere" Binding="{Binding Short}" Width="110"/>
                        <DataGridTextColumn Header="Evaluare" Binding="{Binding Evaluation}" Width="96"/>
                        <DataGridTextColumn Header="Activități" Binding="{Binding ActivityCount}" Width="84"/>
                        <DataGridTextColumn Header="Ore în orar" Binding="{Binding HoursScheduled}" Width="92"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="0" Width="400" Margin="16,0,0,0" Visibility="{Binding HasDraft, Converter={StaticResource BoolToVis}}">
            <Grid>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="30" Visibility="{Binding HasDraft, Converter={StaticResource BoolToVisInv}}">
                    <Border Width="56" Height="56" CornerRadius="28" Background="{DynamicResource Brush.AccentSoft}">
                        <TextBlock Text="&#xE8F1;" Style="{StaticResource Icon}" FontSize="22" Foreground="{DynamicResource Brush.Accent}"/>
                    </Border>
                    <TextBlock Text="Selectați o disciplină" Style="{StaticResource Text.H3}" HorizontalAlignment="Center" Margin="0,14,0,4"/>
                </StackPanel>
                <DockPanel Visibility="{Binding HasDraft, Converter={StaticResource BoolToVis}}">
                    <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,1,0,0" Padding="18,12">
                        <DockPanel>
                            <Button DockPanel.Dock="Left" Style="{StaticResource Btn.Danger}" ui:Ui.Icon="&#xE74D;" Content="Șterge" Command="{Binding DeleteCommand}"
                                    Visibility="{Binding IsNew, Converter={StaticResource BoolToVisInv}}"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Anulează" Command="{Binding CancelCommand}" Margin="0,0,8,0"/>
                                <Button Style="{StaticResource Btn.Primary}" ui:Ui.Icon="&#xE74E;" Content="Salvează" Command="{Binding SaveCommand}" IsDefault="True"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="20,18,20,18">
                            <TextBlock Text="{Binding FormTitle}" Style="{StaticResource Text.H2}" TextWrapping="Wrap" Margin="0,0,0,16"/>

                            <TextBlock Text="Denumirea disciplinei" Style="{StaticResource Text.Label}"/>
                            <TextBox Text="{Binding Draft.Name, UpdateSourceTrigger=PropertyChanged}" ui:Ui.Placeholder="ex. Algoritmi și structuri de date"/>

                            <TextBlock Text="Abrevierea (în orarul general și pe panou)" Style="{StaticResource Text.Label}" Margin="0,14,0,6"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Text="{Binding Draft.ShortName, UpdateSourceTrigger=PropertyChanged}" ui:Ui.Placeholder="ex. ASD"/>
                                <Button Grid.Column="1" Style="{StaticResource Btn.Soft}" Content="Automat" ui:Ui.Icon="&#xE945;" Command="{Binding AutoShortCommand}" Margin="8,0,0,0"/>
                            </Grid>

                            <TextBlock Text="Culoarea" Style="{StaticResource Text.Label}" Margin="0,14,0,6"/>
                            <ListBox ItemsSource="{Binding Colors}" SelectedItem="{Binding Draft.Color}" Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.Template>
                                    <ControlTemplate TargetType="ListBox"><ItemsPresenter/></ControlTemplate>
                                </ListBox.Template>
                                <ListBox.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ListBox.ItemsPanel>
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Cursor" Value="Hand"/>
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Ring" Width="32" Height="32" CornerRadius="10" Margin="0,0,6,6" BorderThickness="2" BorderBrush="Transparent" Padding="3">
                                                        <Border CornerRadius="7" Background="{Binding Converter={StaticResource HexToBrush}}"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Brush.Text}"/>
                                                        </Trigger>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                            <TextBlock Text="Folosită când este activă opțiunea „Colorare după disciplină” (Setări)." Style="{StaticResource Text.Muted}" TextWrapping="Wrap"/>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Forma de evaluare" Style="{StaticResource Text.Label}"/>
                                    <ComboBox ItemsSource="{Binding Evaluations}" SelectedItem="{Binding Draft.Evaluation}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Departamentul" Style="{StaticResource Text.Label}"/>
                                    <TextBox Text="{Binding Draft.Department, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Note" Style="{StaticResource Text.Label}" Margin="0,14,0,6"/>
                            <TextBox Style="{StaticResource Input.Multiline}" Text="{Binding Draft.Notes, UpdateSourceTrigger=PropertyChanged}"/>

                            <Border Background="{DynamicResource Brush.DangerSoft}" CornerRadius="8" Padding="12,9" Margin="0,14,0,0"
                                    Visibility="{Binding ValidationError, Converter={StaticResource NullToVis}}">
                                <TextBlock Text="{Binding ValidationError}" Foreground="{DynamicResource Brush.Danger}" TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
