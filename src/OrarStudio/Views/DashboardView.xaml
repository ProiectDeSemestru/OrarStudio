<UserControl x:Class="OrarStudio.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="clr-namespace:OrarStudio.UI"
             xmlns:vm="clr-namespace:OrarStudio.ViewModels"
             xmlns:m="clr-namespace:OrarStudio.Models">
    <UserControl.Resources>
        <!-- bară orizontală într-un clasament (auditorii, profesori) -->
        <DataTemplate x:Key="RankedBar" DataType="{x:Type vm:BarItem}">
            <Grid Margin="0,4" ToolTip="{Binding Tooltip}" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="56"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding Label}" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Detail}" FontSize="10.5" Foreground="{DynamicResource Brush.TextMuted}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Grid Grid.Column="1" Height="10" VerticalAlignment="Center" Margin="8,0">
                    <Border Background="{DynamicResource Brush.ChartTrack}" CornerRadius="0,4,4,0"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding Ratio, Converter={StaticResource Star}}"/>
                            <ColumnDefinition Width="{Binding Ratio, Converter={StaticResource Star}, ConverterParameter=rest}"/>
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource Brush.ChartBar}" CornerRadius="0,4,4,0"/>
                    </Grid>
                </Grid>
                <TextBlock Grid.Column="2" Text="{Binding ValueText}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="12"
                           Foreground="{DynamicResource Brush.TextSecondary}"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel Margin="24,20,24,24" MaxWidth="1500">

            <!-- ═════════ Antet ═════════ -->
            <Border CornerRadius="16" Padding="26,22" Margin="0,0,0,16">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#4F46E5" Offset="0"/>
                        <GradientStop Color="#7C3AED" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding Greeting}" FontSize="22" FontWeight="Bold" Foreground="White"/>
                        <TextBlock FontSize="13.5" Foreground="#E0E7FF" Margin="0,4,0,0" TextWrapping="Wrap">
                            <Run Text="{Binding WeekText, Mode=OneWay}"/><Run Text=" · "/><Run Text="{Binding TodayText, Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock FontSize="12.5" Foreground="#C7D2FE" Margin="0,8,0,0" TextWrapping="Wrap"
                                   Text="Plasați activitățile prin drag &amp; drop în editor, verificați conflictele și publicați orarul (PDF, site, panou informativ)."/>
                    </StackPanel>
                    <WrapPanel Grid.Column="1" VerticalAlignment="Center" Margin="16,0,0,0" MaxWidth="460">
                        <Button Content="Deschide editorul" ui:Ui.Icon="&#xE787;" Command="{Binding DataContext.GoToCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="orar" Margin="0,0,8,8" Background="White" Foreground="#3730A3" BorderBrush="White"
                                ui:Ui.HoverBackground="#EEF2FF" ui:Ui.PressedBackground="#E0E7FF"/>
                        <Button Content="Generează automat" ui:Ui.Icon="&#xE945;" Command="{Binding DataContext.AutoScheduleCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                Margin="0,0,8,8" Background="#33FFFFFF" Foreground="White" BorderBrush="#55FFFFFF"
                                ui:Ui.HoverBackground="#4DFFFFFF" ui:Ui.PressedBackground="#66FFFFFF"/>
                        <Button Content="Importă sarcina" ui:Ui.Icon="&#xE8E5;" Command="{Binding DataContext.ImportCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                Margin="0,0,8,8" Background="#33FFFFFF" Foreground="White" BorderBrush="#55FFFFFF"
                                ui:Ui.HoverBackground="#4DFFFFFF" ui:Ui.PressedBackground="#66FFFFFF"/>
                        <Button Content="Panou informativ" ui:Ui.Icon="&#xE7F4;" Command="{Binding DataContext.OpenBoardCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                Margin="0,0,8,8" Background="#33FFFFFF" Foreground="White" BorderBrush="#55FFFFFF"
                                ui:Ui.HoverBackground="#4DFFFFFF" ui:Ui.PressedBackground="#66FFFFFF"/>
                    </WrapPanel>
                </Grid>
            </Border>

            <!-- ═════════ Indicatori ═════════ -->
            <UniformGrid Columns="4" Margin="-6,0,-6,10">
                <Border Style="{StaticResource Card.Shadow}" Margin="6">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource Brush.AccentSoft}">
                                <TextBlock Text="&#xE9D9;" Style="{StaticResource Icon}" Foreground="{DynamicResource Brush.Accent}"/>
                            </Border>
                            <TextBlock Text="Sarcina plasată" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding CoverageText}" FontSize="30" FontWeight="Bold" Margin="0,12,0,4"/>
                        <ProgressBar Maximum="1" Value="{Binding Coverage, Mode=OneWay}" Height="6"/>
                        <TextBlock Style="{StaticResource Text.Muted}" Margin="0,8,0,0">
                            <Run Text="{Binding HoursPlaced, Mode=OneWay}"/><Run Text=" din "/><Run Text="{Binding HoursPlanned, Mode=OneWay}"/><Run Text=" ore/săptămână"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card.Shadow}" Margin="6">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource Brush.InfoSoft}">
                                <TextBlock Text="&#xE787;" Style="{StaticResource Icon}" Foreground="{DynamicResource Brush.Info}"/>
                            </Border>
                            <TextBlock Text="Lecții în orar" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Lessons}" FontSize="30" FontWeight="Bold" Margin="0,12,0,4"/>
                        <TextBlock Style="{StaticResource Text.Muted}" Margin="0,12,0,0">
                            <Run Text="{Binding UnplacedActivities, Mode=OneWay}"/><Run Text=" activități încă de plasat"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Margin="6" Cursor="Hand">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Card.Shadow}"/>
                    </Border.Style>
                    <Border.InputBindings>
                        <MouseBinding MouseAction="LeftClick" Command="{Binding DataContext.ShowConflictsCommand, RelativeSource={RelativeSource AncestorType=Window}}"/>
                    </Border.InputBindings>
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="ConflictIconBg" Width="34" Height="34" CornerRadius="10">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource Brush.SuccessSoft}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding ConflictingLessons, Converter={StaticResource CountToVis}}" Value="Visible">
                                                <Setter Property="Background" Value="{DynamicResource Brush.DangerSoft}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock>
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource Icon}">
                                            <Setter Property="Text" Value="&#xE73E;"/>
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Success}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding ConflictingLessons, Converter={StaticResource CountToVis}}" Value="Visible">
                                                    <Setter Property="Text" Value="&#xE783;"/>
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                            <TextBlock Text="Conflicte" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="{Binding ConflictingLessons}" FontSize="30" FontWeight="Bold" Margin="0,12,0,4"/>
                        <TextBlock Style="{StaticResource Text.Muted}" Margin="0,12,0,0" TextWrapping="Wrap">
                            <Run Text="{Binding Warnings, Mode=OneWay}"/><Run Text=" avertismente (sală, capacitate, doleanțe)"/>
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card.Shadow}" Margin="6">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource Brush.WarningSoft}">
                                <TextBlock Text="&#xE7BE;" Style="{StaticResource Icon}" Foreground="{DynamicResource Brush.Warning}"/>
                            </Border>
                            <TextBlock Text="Resurse" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                        <UniformGrid Columns="2" Margin="0,10,0,0">
                            <StackPanel Margin="0,2">
                                <TextBlock Text="{Binding Groups}" FontSize="18" FontWeight="Bold"/>
                                <TextBlock Text="grupe" Style="{StaticResource Text.Muted}"/>
                            </StackPanel>
                            <StackPanel Margin="0,2">
                                <TextBlock Text="{Binding Teachers}" FontSize="18" FontWeight="Bold"/>
                                <TextBlock Text="profesori" Style="{StaticResource Text.Muted}"/>
                            </StackPanel>
                            <StackPanel Margin="0,6,0,0">
                                <TextBlock Text="{Binding Rooms}" FontSize="18" FontWeight="Bold"/>
                                <TextBlock Text="auditorii" Style="{StaticResource Text.Muted}"/>
                            </StackPanel>
                            <StackPanel Margin="0,6,0,0">
                                <TextBlock Text="{Binding Subjects}" FontSize="18" FontWeight="Bold"/>
                                <TextBlock Text="discipline" Style="{StaticResource Text.Muted}"/>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- ═════════ Grafice + probleme ═════════ -->
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="3*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="2*"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <Border Style="{StaticResource Card.Shadow}">
                        <StackPanel>
                            <TextBlock Text="Încărcarea pe zile" Style="{StaticResource Text.H3}"/>
                            <TextBlock Text="Perechi pe săptămână (o lecție impară/pară contează ca ½)" Style="{StaticResource Text.Muted}" Margin="0,2,0,12"/>
                            <Grid Height="170">
                                <!-- linii de grilă discrete -->
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="0,0,0,1"/>
                                <ItemsControl ItemsSource="{Binding DayBars}" Grid.RowSpan="2">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <UniformGrid Rows="1"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:BarItem}">
                                            <Grid ToolTip="{Binding Tooltip}" Background="Transparent">
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*"/>
                                                    <RowDefinition Height="24"/>
                                                </Grid.RowDefinitions>
                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="{Binding Ratio, Converter={StaticResource Star}, ConverterParameter=rest}"/>
                                                        <RowDefinition Height="{Binding Ratio, Converter={StaticResource Star}}"/>
                                                    </Grid.RowDefinitions>
                                                    <Border Grid.Row="1" Background="{DynamicResource Brush.ChartBar}" CornerRadius="4,4,0,0" Margin="18,0" MaxWidth="44">
                                                        <TextBlock Text="{Binding ValueText}" FontSize="11.5" FontWeight="SemiBold" Foreground="White"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0"/>
                                                    </Border>
                                                </Grid>
                                                <TextBlock Grid.Row="1" Text="{Binding Label}" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                                                           FontSize="12" Foreground="{DynamicResource Brush.TextSecondary}"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card.Shadow}" Margin="0,16,0,0">
                        <StackPanel>
                            <TextBlock Text="Tipuri de lecții" Style="{StaticResource Text.H3}"/>
                            <TextBlock Text="Ponderea în numărul total de lecții din orar" Style="{StaticResource Text.Muted}" Margin="0,2,0,12"/>
                            <Grid x:Name="TypeBar" Height="14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding TypeShares[0].Ratio, Converter={StaticResource Star}}"/>
                                    <ColumnDefinition Width="{Binding TypeShares[1].Ratio, Converter={StaticResource Star}}"/>
                                    <ColumnDefinition Width="{Binding TypeShares[2].Ratio, Converter={StaticResource Star}}"/>
                                </Grid.ColumnDefinitions>
                                <Border Background="{DynamicResource Brush.Curs}" CornerRadius="4,0,0,4" Margin="0,0,2,0" ToolTip="{Binding TypeShares[0].Percent}"/>
                                <Border Grid.Column="1" Background="{DynamicResource Brush.Seminar}" Margin="0,0,2,0" ToolTip="{Binding TypeShares[1].Percent}"/>
                                <Border Grid.Column="2" Background="{DynamicResource Brush.Lab}" CornerRadius="0,4,4,0" ToolTip="{Binding TypeShares[2].Percent}"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding TypeShares}" Margin="0,12,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:TypeShare}">
                                        <StackPanel Orientation="Horizontal">
                                            <Border x:Name="Sw" Width="12" Height="12" CornerRadius="3" Background="{DynamicResource Brush.Curs}" VerticalAlignment="Center"/>
                                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center">
                                                <Run Text="{Binding Label, Mode=OneWay}" FontWeight="SemiBold"/>
                                                <Run Text="{Binding Count, Mode=OneWay}" Foreground="{DynamicResource Brush.TextSecondary}"/>
                                                <Run Text="{Binding Percent, Mode=OneWay, StringFormat='({0})'}" Foreground="{DynamicResource Brush.TextMuted}"/>
                                            </TextBlock>
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Type}" Value="{x:Static m:LessonType.Seminar}">
                                                <Setter TargetName="Sw" Property="Background" Value="{DynamicResource Brush.Seminar}"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding Type}" Value="{x:Static m:LessonType.Laborator}">
                                                <Setter TargetName="Sw" Property="Background" Value="{DynamicResource Brush.Lab}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Border Grid.Column="2" Style="{StaticResource Card.Shadow}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <TextBlock Text="Probleme detectate" Style="{StaticResource Text.H3}"/>
                            <TextBlock Text="Conflicte și avertismente (clic pentru a deschide în editor)" Style="{StaticResource Text.Muted}" Margin="0,2,0,0"/>
                        </StackPanel>
                        <Grid>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding HasIssues, Converter={StaticResource BoolToVisInv}}" Margin="0,24">
                                <Border Width="54" Height="54" CornerRadius="27" Background="{DynamicResource Brush.SuccessSoft}">
                                    <TextBlock Text="&#xE73E;" Style="{StaticResource Icon}" FontSize="24" Foreground="{DynamicResource Brush.Success}"/>
                                </Border>
                                <TextBlock Text="Orarul nu are conflicte" Style="{StaticResource Text.H3}" HorizontalAlignment="Center" Margin="0,12,0,2"/>
                                <TextBlock Text="Profesorii, grupele și auditoriile nu se suprapun." Style="{StaticResource Text.Muted}" HorizontalAlignment="Center"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding TopIssues}" Visibility="{Binding HasIssues, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:IssueVM}">
                                        <Button Style="{StaticResource Btn.Ghost}" HorizontalContentAlignment="Stretch" Padding="8,7" Margin="0,0,0,2" FontWeight="Normal"
                                                Command="{Binding DataContext.OpenIssueCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="22"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock x:Name="I" Text="&#xE7BA;" Style="{StaticResource Icon}" FontSize="12" Foreground="{DynamicResource Brush.Warning}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource Brush.Text}"/>
                                                    <TextBlock Text="{Binding Where}" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" TextTrimming="CharacterEllipsis" Margin="0,2,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsError}" Value="True">
                                                <Setter TargetName="I" Property="Text" Value="&#xE783;"/>
                                                <Setter TargetName="I" Property="Foreground" Value="{DynamicResource Brush.Danger}"/>
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </DockPanel>
                </Border>
            </Grid>

            <!-- ═════════ Clasamente ═════════ -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card.Shadow}">
                    <StackPanel>
                        <TextBlock Text="Ocuparea auditoriilor" Style="{StaticResource Text.H3}"/>
                        <TextBlock Text="Procent din timpul disponibil în săptămână · clic pentru orarul sălii" Style="{StaticResource Text.Muted}" Margin="0,2,0,10"/>
                        <ItemsControl ItemsSource="{Binding RoomBars}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:BarItem}">
                                    <Button Style="{StaticResource Btn.Ghost}" Padding="6,0" MinHeight="0" HorizontalContentAlignment="Stretch" FontWeight="Normal"
                                            Command="{Binding DataContext.OpenRoomCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource RankedBar}"/>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card.Shadow}">
                    <StackPanel>
                        <TextBlock Text="Cei mai încărcați profesori" Style="{StaticResource Text.H3}"/>
                        <TextBlock Text="Ore pe săptămână în orar · clic pentru orarul profesorului" Style="{StaticResource Text.Muted}" Margin="0,2,0,10"/>
                        <ItemsControl ItemsSource="{Binding TeacherBars}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:BarItem}">
                                    <Button Style="{StaticResource Btn.Ghost}" Padding="6,0" MinHeight="0" HorizontalContentAlignment="Stretch" FontWeight="Normal"
                                            Command="{Binding DataContext.OpenTeacherCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}">
                                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource RankedBar}"/>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
