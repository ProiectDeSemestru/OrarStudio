<Window x:Class="OrarStudio.Views.ImportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:OrarStudio.UI"
        xmlns:imp="clr-namespace:OrarStudio.Import"
        Style="{StaticResource DialogWindow}" Title="Import — Orar Studio">
    <Window.Resources>
        <Style x:Key="CellEdit" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="2,0"/>
            <Setter Property="Background" Value="{DynamicResource Brush.Input}"/>
            <Setter Property="Foreground" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource Brush.Text}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Border Style="{StaticResource DialogShell}" Width="1220" Height="780">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid x:Name="Header" Margin="24,20,16,14" Background="Transparent">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border Width="40" Height="40" CornerRadius="12" Background="{DynamicResource Brush.AccentSoft}">
                    <TextBlock Text="&#xE8E5;" Style="{StaticResource Icon}" Foreground="{DynamicResource Brush.Accent}"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Import sarcină didactică — previzualizare" Style="{StaticResource Text.H2}"/>
                    <TextBlock Text="{Binding FilesText}" Style="{StaticResource Text.Muted}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource Btn.Icon}" ui:Ui.Icon="&#xE711;" Command="{Binding CancelCommand}" VerticalAlignment="Top"/>
            </Grid>

            <Grid Grid.Row="1" Margin="24,0,24,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="300"/>
                </Grid.ColumnDefinitions>

                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <ToggleButton Style="{StaticResource Switch}" Content="Doar cu avertismente" IsChecked="{Binding OnlyWarnings}" Margin="0,0,14,0"/>
                            <Button Style="{StaticResource Btn.Ghost}" Content="Selectează tot" Command="{Binding SelectAllCommand}" Padding="8,4" MinHeight="30"/>
                            <Button Style="{StaticResource Btn.Ghost}" Content="Nimic" Command="{Binding SelectNoneCommand}" Padding="8,4" MinHeight="30"/>
                        </StackPanel>
                        <TextBlock Text="{Binding Summary}" Style="{StaticResource Text.Secondary}" VerticalAlignment="Center"/>
                    </DockPanel>
                    <Border BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                        <DataGrid ItemsSource="{Binding RowsView}" IsReadOnly="False" SelectionUnit="CellOrRowHeader" MinRowHeight="36" FontSize="12.5"
                                  CanUserSortColumns="True">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="" Width="40" CanUserSort="False">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type imp:ImportRow}">
                                            <CheckBox IsChecked="{Binding Include, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Disciplina" Binding="{Binding Subject}" Width="2*" EditingElementStyle="{StaticResource CellEdit}"/>
                                <DataGridTemplateColumn Header="Tip" Width="104" SortMemberPath="Type">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type imp:ImportRow}">
                                            <TextBlock Text="{Binding Type, Converter={StaticResource EnumLabel}}" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    <DataGridTemplateColumn.CellEditingTemplate>
                                        <DataTemplate DataType="{x:Type imp:ImportRow}">
                                            <ComboBox ItemsSource="{Binding DataContext.Types, RelativeSource={RelativeSource AncestorType=Window}}" SelectedItem="{Binding Type, UpdateSourceTrigger=PropertyChanged}" MinHeight="30" Padding="8,4,26,4">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate><TextBlock Text="{Binding Converter={StaticResource EnumLabel}}"/></DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellEditingTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Ore" Binding="{Binding Hours}" Width="50" EditingElementStyle="{StaticResource CellEdit}"/>
                                <DataGridTextColumn Header="Grupe" Binding="{Binding Groups}" Width="1.4*" EditingElementStyle="{StaticResource CellEdit}"/>
                                <DataGridTextColumn Header="Stud." Binding="{Binding Students}" Width="54" EditingElementStyle="{StaticResource CellEdit}"/>
                                <DataGridTextColumn Header="Profesor" Binding="{Binding Teacher}" Width="1.6*" EditingElementStyle="{StaticResource CellEdit}"/>
                                <DataGridTemplateColumn Header="Observații" Width="1.6*" IsReadOnly="True" SortMemberPath="Warning">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type imp:ImportRow}">
                                            <TextBlock Text="{Binding Warning}" Foreground="{DynamicResource Brush.Warning}" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding Source}" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </DockPanel>

                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Background="{DynamicResource Brush.SurfaceAlt}" CornerRadius="10" Padding="14,12" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Opțiuni" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                <CheckBox Content="Înlocuiește sarcina didactică existentă" IsChecked="{Binding Replace}" Margin="0,0,0,6"/>
                                <TextBlock Text="Altfel, activitățile se adaugă (duplicatele sunt ignorate)." Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="27,0,0,10"/>
                                <CheckBox Content="Actualizează datele semestrului" IsChecked="{Binding UpdateSettings}" Margin="0,0,0,6"/>
                                <TextBlock Text="{Binding SettingsInfo}" Style="{StaticResource Text.Muted}" TextWrapping="Wrap" Margin="27,0,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource Brush.WarningSoft}" CornerRadius="10" Padding="14,12" Margin="0,12,0,0"
                                Visibility="{Binding HasWishes, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="&#xE823;" Style="{StaticResource Icon}" FontSize="13" Foreground="{DynamicResource Brush.Warning}" Margin="0,0,8,0"/>
                                    <TextBlock Text="Doleanțe găsite în fișier" FontWeight="SemiBold"/>
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding Wishes}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,6" FontStyle="Italic"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <CheckBox IsChecked="{Binding ApplyWishes}" Margin="0,4,0,0">
                                    <TextBlock TextWrapping="Wrap">
                                        <Run Text="Marchează ca indisponibil: "/><Run Text="{Binding WishSlots, Mode=OneWay}" FontWeight="SemiBold"/><Run Text=" (profesorii din acest fișier)"/>
                                    </TextBlock>
                                </CheckBox>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource Brush.InfoSoft}" CornerRadius="10" Padding="14,12" Margin="0,12,0,0"
                                Visibility="{Binding HasMessages, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="Rânduri ignorate / note" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <ItemsControl ItemsSource="{Binding Messages}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="11.5" Margin="0,0,0,5" Foreground="{DynamicResource Brush.TextSecondary}"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <TextBlock Margin="2,12,0,0" Style="{StaticResource Text.Muted}" TextWrapping="Wrap"
                                   Text="Celulele se pot corecta înainte de import (dublu-clic). Grupele, profesorii și disciplinele noi se creează automat; cele existente sunt recunoscute după nume."/>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <Border Grid.Row="2" Style="{StaticResource DialogFooter}" Margin="0,16,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Anulează" Command="{Binding CancelCommand}" Margin="0,0,8,0" MinWidth="96"/>
                    <Button Style="{StaticResource Btn.Primary}" ui:Ui.Icon="&#xE8E5;" Content="Importă selecția" Command="{Binding ConfirmCommand}" MinWidth="140"/>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
