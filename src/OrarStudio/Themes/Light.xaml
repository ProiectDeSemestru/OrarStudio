<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Temă luminoasă: aceleași chei ca în Dark.xaml (folosite prin DynamicResource) -->
    <Color x:Key="C.Shadow">#1E293B</Color>
    <Color x:Key="C.Accent">#4F46E5</Color>

    <SolidColorBrush x:Key="Brush.Window" Color="#F4F6FB"/>
    <SolidColorBrush x:Key="Brush.Surface" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="Brush.Sunken" Color="#EEF2F7"/>
    <SolidColorBrush x:Key="Brush.Border" Color="#E3E8F0"/>
    <SolidColorBrush x:Key="Brush.BorderStrong" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="Brush.GridLine" Color="#E8ECF3"/>

    <SolidColorBrush x:Key="Brush.Text" Color="#0F172A"/>
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#475569"/>
    <SolidColorBrush x:Key="Brush.TextMuted" Color="#8A94A6"/>

    <SolidColorBrush x:Key="Brush.Accent" Color="#4F46E5"/>
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#4338CA"/>
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#3730A3"/>
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#EEF0FF"/>
    <SolidColorBrush x:Key="Brush.AccentSoftText" Color="#4338CA"/>
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#FFFFFF"/>

    <SolidColorBrush x:Key="Brush.Hover" Color="#F1F4F9"/>
    <SolidColorBrush x:Key="Brush.Pressed" Color="#E6EBF2"/>
    <SolidColorBrush x:Key="Brush.Selection" Color="#EEF0FF"/>

    <SolidColorBrush x:Key="Brush.Success" Color="#059669"/>
    <SolidColorBrush x:Key="Brush.SuccessSoft" Color="#E7F7F0"/>
    <SolidColorBrush x:Key="Brush.Warning" Color="#D97706"/>
    <SolidColorBrush x:Key="Brush.WarningSoft" Color="#FEF5E7"/>
    <SolidColorBrush x:Key="Brush.Danger" Color="#DC2626"/>
    <SolidColorBrush x:Key="Brush.DangerSoft" Color="#FDECEC"/>
    <SolidColorBrush x:Key="Brush.Info" Color="#0284C7"/>
    <SolidColorBrush x:Key="Brush.InfoSoft" Color="#E8F4FB"/>

    <LinearGradientBrush x:Key="Brush.Sidebar" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#141B3A" Offset="0"/>
        <GradientStop Color="#0E1428" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Brush.SidebarText" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="Brush.SidebarTextMuted" Color="#6B7A99"/>
    <SolidColorBrush x:Key="Brush.SidebarHover" Color="#1F2A4D"/>
    <SolidColorBrush x:Key="Brush.SidebarSelected" Color="#4F46E5"/>
    <SolidColorBrush x:Key="Brush.SidebarBorder" Color="#222C4D"/>

    <!-- Tipuri de lecții (paletă validată: CVD toate perechile ≥ 8, contrast ≥ 3:1) -->
    <SolidColorBrush x:Key="Brush.Curs" Color="#4F46E5"/>
    <SolidColorBrush x:Key="Brush.CursSoft" Color="#EEF0FF"/>
    <SolidColorBrush x:Key="Brush.Seminar" Color="#EA580C"/>
    <SolidColorBrush x:Key="Brush.SeminarSoft" Color="#FFF1E8"/>
    <SolidColorBrush x:Key="Brush.Lab" Color="#0D9488"/>
    <SolidColorBrush x:Key="Brush.LabSoft" Color="#E6F7F5"/>

    <SolidColorBrush x:Key="Brush.Input" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Brush.InputBorder" Color="#D6DCE6"/>
    <SolidColorBrush x:Key="Brush.ScrollThumb" Color="#C7D0DC"/>
    <SolidColorBrush x:Key="Brush.Overlay" Color="#590F172A"/>
    <SolidColorBrush x:Key="Brush.Tooltip" Color="#111827"/>
    <SolidColorBrush x:Key="Brush.TooltipText" Color="#F8FAFC"/>

    <SolidColorBrush x:Key="Brush.DropOk" Color="#E3F8EE"/>
    <SolidColorBrush x:Key="Brush.DropWarn" Color="#FEF3DC"/>
    <SolidColorBrush x:Key="Brush.DropBad" Color="#FDE8E8"/>
    <SolidColorBrush x:Key="Brush.Today" Color="#F6F7FF"/>
    <SolidColorBrush x:Key="Brush.ChartBar" Color="#4F46E5"/>
    <SolidColorBrush x:Key="Brush.ChartTrack" Color="#EEF1F6"/>

    <DrawingBrush x:Key="Brush.Hatch" TileMode="Tile" Viewport="0,0,8,8" ViewportUnits="Absolute" Viewbox="0,0,8,8" ViewboxUnits="Absolute">
        <DrawingBrush.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#F4F5F8">
                    <GeometryDrawing.Geometry>
                        <RectangleGeometry Rect="0,0,8,8"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing>
                    <GeometryDrawing.Pen>
                        <Pen Brush="#E1E5EC" Thickness="1.2"/>
                    </GeometryDrawing.Pen>
                    <GeometryDrawing.Geometry>
                        <LineGeometry StartPoint="0,8" EndPoint="8,0"/>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingBrush.Drawing>
    </DrawingBrush>
</ResourceDictionary>
