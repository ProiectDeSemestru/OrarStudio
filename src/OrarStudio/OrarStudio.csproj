<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>OrarStudio</RootNamespace>
    <AssemblyName>OrarStudio</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Product>Orar Studio</Product>
    <AssemblyTitle>Orar Studio — planificator de orar universitar</AssemblyTitle>
    <Description>Aplicație desktop pentru elaborarea, verificarea, exportul și publicarea orarului universitar.</Description>
    <Version>1.0.0</Version>
    <Copyright>© 2026 Orar Studio</Copyright>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- MVVMTK0042/0045: sugestii pentru proprietăți parțiale (nu sunt necesare în WPF) -->
    <NoWarn>$(NoWarn);MVVMTK0042;MVVMTK0045</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- Server HTTP integrat (API REST + site + panou web) -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="QuestPDF" Version="2026.9.1" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Web\**" />
    <EmbeddedResource Include="Web\**\*.*" LogicalName="Web/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Samples\*.xlsx" LogicalName="Samples/%(Filename)%(Extension)" />
    <None Update="Samples\**\*.*" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="Assets\app.ico" />
    <Resource Include="Assets\logo.png" />
  </ItemGroup>

</Project>
