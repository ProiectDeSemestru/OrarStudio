<Application x:Class="OrarStudio.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:OrarStudio.ViewModels"
             xmlns:v="clr-namespace:OrarStudio.Views"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- [0] culori (înlocuit la schimbarea temei), [1] stiluri -->
                <ResourceDictionary Source="Themes/Light.xaml"/>
                <ResourceDictionary Source="Themes/Controls.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Pagini: ViewModel → View -->
            <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><v:DashboardView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:TimetableViewModel}"><v:TimetableView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:OverviewViewModel}"><v:OverviewView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ActivitiesViewModel}"><v:ActivitiesView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:GroupsViewModel}"><v:GroupsView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:TeachersViewModel}"><v:TeachersView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:SubjectsViewModel}"><v:SubjectsView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:RoomsViewModel}"><v:RoomsView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:ExportViewModel}"><v:ExportView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:WebApiViewModel}"><v:WebApiView/></DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><v:SettingsView/></DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
